package com.pgmanagement.dao;

import java.util.List;

import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Repository;

import com.pgmanagement.model.Room;

@Repository
public class RoomDAO {

    private final JdbcTemplate jdbcTemplate;

    public RoomDAO(
            JdbcTemplate jdbcTemplate) {

        this.jdbcTemplate = jdbcTemplate;
    }

    public boolean addRoom(
            Room room) {

        String sql =
                "INSERT INTO rooms "
              + "(property_id, room_number, capacity, "
              + "sharing_type, rent_amount, status) "
              + "VALUES (?, ?, ?, ?, ?, ?)";

        int rows =
                jdbcTemplate.update(
                        sql,
                        room.getPropertyId(),
                        room.getRoomNumber(),
                        room.getCapacity(),
                        room.getSharingType(),
                        room.getRentAmount(),
                        room.getStatus()
                );

        return rows > 0;
    }

    public List<Room> getAllRooms() {

        String sql =
                "SELECT r.*, "
              + "p.property_name AS property_name "
              + "FROM rooms r "
              + "LEFT JOIN properties p "
              + "ON r.property_id = p.id "
              + "ORDER BY r.id DESC";

        return jdbcTemplate.query(
                sql,
                (rs, rowNum) -> {

                    Room room =
                            new Room();

                    room.setId(
                            rs.getInt("id")
                    );

                    room.setPropertyId(
                            rs.getInt("property_id")
                    );

                    room.setPropertyName(
                            rs.getString(
                                    "property_name"
                            )
                    );

                    room.setRoomNumber(
                            rs.getString(
                                    "room_number"
                            )
                    );

                    room.setCapacity(
                            rs.getInt("capacity")
                    );

                    room.setSharingType(
                            rs.getString(
                                    "sharing_type"
                            )
                    );

                    room.setRentAmount(
                            rs.getBigDecimal(
                                    "rent_amount"
                            )
                    );

                    room.setStatus(
                            rs.getString("status")
                    );

                    return room;
                }
        );
    }

    public List<Room> searchRooms(
            String keyword) {

        String sql =
                "SELECT r.*, "
              + "p.property_name AS property_name "
              + "FROM rooms r "
              + "LEFT JOIN properties p "
              + "ON r.property_id = p.id "
              + "WHERE r.room_number LIKE ? "
              + "OR r.sharing_type LIKE ? "
              + "OR r.status LIKE ? "
              + "OR CAST(r.property_id AS CHAR) LIKE ? "
              + "OR p.property_name LIKE ? "
              + "ORDER BY r.id DESC";

        String searchKeyword =
                "%" + keyword + "%";

        return jdbcTemplate.query(
                sql,
                (rs, rowNum) -> {

                    Room room =
                            new Room();

                    room.setId(
                            rs.getInt("id")
                    );

                    room.setPropertyId(
                            rs.getInt("property_id")
                    );

                    room.setPropertyName(
                            rs.getString(
                                    "property_name"
                            )
                    );

                    room.setRoomNumber(
                            rs.getString(
                                    "room_number"
                            )
                    );

                    room.setCapacity(
                            rs.getInt("capacity")
                    );

                    room.setSharingType(
                            rs.getString(
                                    "sharing_type"
                            )
                    );

                    room.setRentAmount(
                            rs.getBigDecimal(
                                    "rent_amount"
                            )
                    );

                    room.setStatus(
                            rs.getString("status")
                    );

                    return room;
                },
                searchKeyword,
                searchKeyword,
                searchKeyword,
                searchKeyword,
                searchKeyword
        );
    }

    public List<Room> getAvailableRooms() {

        String sql =
                "SELECT r.*, "
              + "p.property_name AS property_name "
              + "FROM rooms r "
              + "LEFT JOIN properties p "
              + "ON r.property_id = p.id "
              + "WHERE r.status = 'Available' "
              + "ORDER BY r.room_number";

        return jdbcTemplate.query(
                sql,
                (rs, rowNum) -> {

                    Room room =
                            new Room();

                    room.setId(
                            rs.getInt("id")
                    );

                    room.setPropertyId(
                            rs.getInt("property_id")
                    );

                    room.setPropertyName(
                            rs.getString(
                                    "property_name"
                            )
                    );

                    room.setRoomNumber(
                            rs.getString(
                                    "room_number"
                            )
                    );

                    room.setCapacity(
                            rs.getInt("capacity")
                    );

                    room.setSharingType(
                            rs.getString(
                                    "sharing_type"
                            )
                    );

                    room.setRentAmount(
                            rs.getBigDecimal(
                                    "rent_amount"
                            )
                    );

                    room.setStatus(
                            rs.getString("status")
                    );

                    return room;
                }
        );
    }

    public Room getRoomById(
            int id) {

        String sql =
                "SELECT r.*, "
              + "p.property_name AS property_name "
              + "FROM rooms r "
              + "LEFT JOIN properties p "
              + "ON r.property_id = p.id "
              + "WHERE r.id = ?";

        List<Room> rooms =
                jdbcTemplate.query(
                        sql,
                        (rs, rowNum) -> {

                            Room room =
                                    new Room();

                            room.setId(
                                    rs.getInt("id")
                            );

                            room.setPropertyId(
                                    rs.getInt(
                                            "property_id"
                                    )
                            );

                            room.setPropertyName(
                                    rs.getString(
                                            "property_name"
                                    )
                            );

                            room.setRoomNumber(
                                    rs.getString(
                                            "room_number"
                                    )
                            );

                            room.setCapacity(
                                    rs.getInt(
                                            "capacity"
                                    )
                            );

                            room.setSharingType(
                                    rs.getString(
                                            "sharing_type"
                                    )
                            );

                            room.setRentAmount(
                                    rs.getBigDecimal(
                                            "rent_amount"
                                    )
                            );

                            room.setStatus(
                                    rs.getString(
                                            "status"
                                    )
                            );

                            return room;
                        },
                        id
                );

        if (rooms.isEmpty()) {

            return null;
        }

        return rooms.get(0);
    }

    public boolean updateRoom(
            Room room) {

        String sql =
                "UPDATE rooms SET "
              + "property_id = ?, "
              + "room_number = ?, "
              + "capacity = ?, "
              + "sharing_type = ?, "
              + "rent_amount = ?, "
              + "status = ? "
              + "WHERE id = ?";

        int rows =
                jdbcTemplate.update(
                        sql,
                        room.getPropertyId(),
                        room.getRoomNumber(),
                        room.getCapacity(),
                        room.getSharingType(),
                        room.getRentAmount(),
                        room.getStatus(),
                        room.getId()
                );

        return rows > 0;
    }

    public int getAllocationCountByRoomId(
            int roomId) {

        String sql =
                "SELECT COUNT(*) "
              + "FROM room_allocations "
              + "WHERE room_id = ?";

        Integer count =
                jdbcTemplate.queryForObject(
                        sql,
                        Integer.class,
                        roomId
                );

        return count == null ? 0 : count;
    }

    public boolean deleteRoom(
            int id) {

        String sql =
                "DELETE FROM rooms "
              + "WHERE id = ?";

        int rows =
                jdbcTemplate.update(
                        sql,
                        id
                );

        return rows > 0;
    }

    public boolean updateRoomStatus(
            int roomId,
            String status) {

        String sql =
                "UPDATE rooms "
              + "SET status = ? "
              + "WHERE id = ?";

        int rows =
                jdbcTemplate.update(
                        sql,
                        status,
                        roomId
                );

        return rows > 0;
    }
}