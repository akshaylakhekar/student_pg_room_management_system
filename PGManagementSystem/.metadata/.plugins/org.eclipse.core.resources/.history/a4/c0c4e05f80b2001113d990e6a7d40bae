<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">

    <title>Complaint List</title>

</head>

<body>

    <h2>Complaint List</h2>

    <a href="${pageContext.request.contextPath}/complaint/add">
        Add New Complaint
    </a>

    <br><br>

    <!-- Search Complaint -->

    <form action="${pageContext.request.contextPath}/complaint/list"
          method="get">

        <label>Search Complaint:</label>

        <input type="text"
               name="keyword"
               value="${keyword}"
               placeholder="Student ID, Category, Description or Status">

        <button type="submit">
            Search
        </button>

        <a href="${pageContext.request.contextPath}/complaint/list">
            Clear
        </a>

    </form>

    <br>

    <p>
        Total Complaints: ${complaints.size()}
    </p>

    <table border="1"
           cellpadding="10"
           cellspacing="0">

        <thead>

            <tr>

                <th>ID</th>
                <th>Student ID</th>
                <th>Category</th>
                <th>Description</th>
                <th>Status</th>
                <th>Created At</th>
                <th>Actions</th>

            </tr>

        </thead>

        <tbody>

            <c:forEach var="complaint"
                       items="${complaints}">

                <tr>

                    <td>
                        ${complaint.id}
                    </td>

                    <td>
                        ${complaint.studentId}
                    </td>

                    <td>
                        ${complaint.category}
                    </td>

                    <td>
                        ${complaint.description}
                    </td>

                    <td>
                        ${complaint.status}
                    </td>

                    <td>
                        ${complaint.createdAt}
                    </td>

                    <td>

                        <a href="${pageContext.request.contextPath}/complaint/edit?id=${complaint.id}">
                            Edit
                        </a>

                        &nbsp; | &nbsp;

                        <a href="${pageContext.request.contextPath}/complaint/delete?id=${complaint.id}"
                           onclick="return confirm('Are you sure you want to delete this complaint?');">
                            Delete
                        </a>

                    </td>

                </tr>

            </c:forEach>

        </tbody>

    </table>

    <br>

    <a href="${pageContext.request.contextPath}/dashboard">
        Back to Dashboard
    </a>

</body>

</html>