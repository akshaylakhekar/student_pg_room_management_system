<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">

    <title>Student Visitors</title>

</head>

<body>

    <h2>Student Visitors</h2>

    <c:choose>

        <c:when test="${not empty student}">

            <h3>Student Information</h3>

            <table border="1"
                   cellpadding="10"
                   cellspacing="0">

                <tr>
                    <th>Student ID</th>
                    <td>${student.id}</td>
                </tr>

                <tr>
                    <th>Name</th>
                    <td>${student.name}</td>
                </tr>

                <tr>
                    <th>Email</th>
                    <td>${student.email}</td>
                </tr>

                <tr>
                    <th>Mobile</th>
                    <td>${student.mobile}</td>
                </tr>

            </table>

            <br>

            <a href="${pageContext.request.contextPath}/visitor/add?studentId=${student.id}">
                Add New Visitor
            </a>

            <br><br>

            <p>
                Total Visitors:
                <strong>${visitors.size()}</strong>
            </p>

            <c:choose>

                <c:when test="${not empty visitors}">

                    <table border="1"
                           cellpadding="10"
                           cellspacing="0">

                        <thead>

                            <tr>

                                <th>ID</th>
                                <th>Visitor Name</th>
                                <th>Relation</th>
                                <th>Entry Time</th>
                                <th>Exit Time</th>
                                <th>Actions</th>

                            </tr>

                        </thead>

                        <tbody>

                            <c:forEach var="visitor"
                                       items="${visitors}">

                                <tr>

                                    <td>
                                        ${visitor.id}
                                    </td>

                                    <td>
                                        ${visitor.visitorName}
                                    </td>

                                    <td>
                                        ${visitor.relation}
                                    </td>

                                    <td>
                                        ${visitor.entryTime}
                                    </td>

                                    <td>

                                        <c:choose>

                                            <c:when test="${not empty visitor.exitTime}">
                                                ${visitor.exitTime}
                                            </c:when>

                                            <c:otherwise>
                                                Still Inside
                                            </c:otherwise>

                                        </c:choose>

                                    </td>

                                    <td>

                                        <a href="${pageContext.request.contextPath}/visitor/edit?id=${visitor.id}">
                                            Edit
                                        </a>

                                        &nbsp; | &nbsp;

                                        <a href="${pageContext.request.contextPath}/visitor/delete?id=${visitor.id}"
                                           onclick="return confirm('Are you sure you want to delete this visitor record?');">
                                            Delete
                                        </a>

                                    </td>

                                </tr>

                            </c:forEach>

                        </tbody>

                    </table>

                </c:when>

                <c:otherwise>

                    <p>
                        No visitors found for this student.
                    </p>

                </c:otherwise>

            </c:choose>

            <br>

            <a href="${pageContext.request.contextPath}/student/profile?id=${student.id}">
                Back to Student Profile
            </a>

            <br><br>

            <a href="${pageContext.request.contextPath}/visitor/list">
                View All Visitors
            </a>

            <br><br>

            <a href="${pageContext.request.contextPath}/dashboard">
                Back to Dashboard
            </a>

        </c:when>

        <c:otherwise>

            <p>
                Student not found.
            </p>

            <br>

            <a href="${pageContext.request.contextPath}/visitor/list">
                Back to Visitor List
            </a>

        </c:otherwise>

    </c:choose>

</body>

</html>