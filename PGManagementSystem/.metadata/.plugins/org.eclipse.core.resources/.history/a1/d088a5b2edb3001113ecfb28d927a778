package com.pgmanagement.dao;

import java.sql.Date;
import java.util.List;

import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Repository;

import com.pgmanagement.model.RoomAllocation;

@Repository
public class RoomAllocationDAO {

    private final JdbcTemplate jdbcTemplate;

    public RoomAllocationDAO(
            JdbcTemplate jdbcTemplate) {

        this.jdbcTemplate = jdbcTemplate;
    }

    public boolean addAllocation(
            RoomAllocation allocation) {

        String sql =
                "INSERT INTO room_allocations "
              + "(student_id, room_id, allocation_date, "
              + "checkout_date, status) "
              + "VALUES (?, ?, ?, ?, ?)";

        Date allocationDate = null;
        Date checkoutDate = null;

        if (allocation.getAllocationDate() != null) {

            allocationDate =
                    Date.valueOf(
                            allocation.getAllocationDate()
                    );
        }

        if (allocation.getCheckoutDate() != null) {

            checkoutDate =
                    Date.valueOf(
                            allocation.getCheckoutDate()
                    );
        }

        int rows =
                jdbcTemplate.update(
                        sql,
                        allocation.getStudentId(),
                        allocation.getRoomId(),
                        allocationDate,
                        checkoutDate,
                        allocation.getStatus()
                );

        return rows > 0;
    }

    public List<RoomAllocation>
            getAllAllocations() {

        String sql =
                "SELECT ra.*, "
              + "s.name AS student_name, "
              + "r.room_number AS room_number, "
              + "r.rent_amount AS rent_amount "
              + "FROM room_allocations ra "
              + "LEFT JOIN students s "
              + "ON ra.student_id = s.id "
              + "LEFT JOIN rooms r "
              + "ON ra.room_id = r.id "
              + "ORDER BY ra.id DESC";

        return jdbcTemplate.query(
                sql,
                (rs, rowNum) -> {

                    RoomAllocation allocation =
                            new RoomAllocation();

                    allocation.setId(
                            rs.getInt("id")
                    );

                    allocation.setStudentId(
                            rs.getInt(
                                    "student_id"
                            )
                    );

                    allocation.setRoomId(
                            rs.getInt(
                                    "room_id"
                            )
                    );

                    if (rs.getDate(
                            "allocation_date"
                    ) != null) {

                        allocation.setAllocationDate(
                                rs.getDate(
                                        "allocation_date"
                                ).toLocalDate()
                        );
                    }

                    if (rs.getDate(
                            "checkout_date"
                    ) != null) {

                        allocation.setCheckoutDate(
                                rs.getDate(
                                        "checkout_date"
                                ).toLocalDate()
                        );
                    }

                    allocation.setStatus(
                            rs.getString("status")
                    );

                    allocation.setStudentName(
                            rs.getString(
                                    "student_name"
                            )
                    );

                    allocation.setRoomNumber(
                            rs.getString(
                                    "room_number"
                            )
                    );

                    allocation.setRentAmount(
                            rs.getBigDecimal(
                                    "rent_amount"
                            )
                    );

                    return allocation;
                }
        );
    }

    public List<RoomAllocation>
            searchAllocations(
                    String keyword) {

        String sql =
                "SELECT ra.*, "
              + "s.name AS student_name, "
              + "r.room_number AS room_number, "
              + "r.rent_amount AS rent_amount "
              + "FROM room_allocations ra "
              + "LEFT JOIN students s "
              + "ON ra.student_id = s.id "
              + "LEFT JOIN rooms r "
              + "ON ra.room_id = r.id "
              + "WHERE CAST(ra.student_id AS CHAR) LIKE ? "
              + "OR CAST(ra.room_id AS CHAR) LIKE ? "
              + "OR CAST(ra.id AS CHAR) LIKE ? "
              + "OR s.name LIKE ? "
              + "OR r.room_number LIKE ? "
              + "OR ra.status LIKE ? "
              + "ORDER BY ra.id DESC";

        String searchKeyword =
                "%" + keyword + "%";

        return jdbcTemplate.query(
                sql,
                (rs, rowNum) -> {

                    RoomAllocation allocation =
                            new RoomAllocation();

                    allocation.setId(
                            rs.getInt("id")
                    );

                    allocation.setStudentId(
                            rs.getInt(
                                    "student_id"
                            )
                    );

                    allocation.setRoomId(
                            rs.getInt(
                                    "room_id"
                            )
                    );

                    if (rs.getDate(
                            "allocation_date"
                    ) != null) {

                        allocation.setAllocationDate(
                                rs.getDate(
                                        "allocation_date"
                                ).toLocalDate()
                        );
                    }

                    if (rs.getDate(
                            "checkout_date"
                    ) != null) {

                        allocation.setCheckoutDate(
                                rs.getDate(
                                        "checkout_date"
                                ).toLocalDate()
                        );
                    }

                    allocation.setStatus(
                            rs.getString("status")
                    );

                    allocation.setStudentName(
                            rs.getString(
                                    "student_name"
                            )
                    );

                    allocation.setRoomNumber(
                            rs.getString(
                                    "room_number"
                            )
                    );

                    allocation.setRentAmount(
                            rs.getBigDecimal(
                                    "rent_amount"
                            )
                    );

                    return allocation;
                },
                searchKeyword,
                searchKeyword,
                searchKeyword,
                searchKeyword,
                searchKeyword,
                searchKeyword
        );
    }

    public RoomAllocation getAllocationById(
            int id) {

        String sql =
                "SELECT ra.*, "
              + "s.name AS student_name, "
              + "r.room_number AS room_number, "
              + "r.rent_amount AS rent_amount "
              + "FROM room_allocations ra "
              + "LEFT JOIN students s "
              + "ON ra.student_id = s.id "
              + "LEFT JOIN rooms r "
              + "ON ra.room_id = r.id "
              + "WHERE ra.id = ?";

        List<RoomAllocation> allocations =
                jdbcTemplate.query(
                        sql,
                        (rs, rowNum) -> {

                            RoomAllocation allocation =
                                    new RoomAllocation();

                            allocation.setId(
                                    rs.getInt("id")
                            );

                            allocation.setStudentId(
                                    rs.getInt(
                                            "student_id"
                                    )
                            );

                            allocation.setRoomId(
                                    rs.getInt(
                                            "room_id"
                                    )
                            );

                            if (rs.getDate(
                                    "allocation_date"
                            ) != null) {

                                allocation
                                        .setAllocationDate(
                                                rs.getDate(
                                                        "allocation_date"
                                                ).toLocalDate()
                                        );
                            }

                            if (rs.getDate(
                                    "checkout_date"
                            ) != null) {

                                allocation
                                        .setCheckoutDate(
                                                rs.getDate(
                                                        "checkout_date"
                                                ).toLocalDate()
                                        );
                            }

                            allocation.setStatus(
                                    rs.getString(
                                            "status"
                                    )
                            );

                            allocation.setStudentName(
                                    rs.getString(
                                            "student_name"
                                    )
                            );

                            allocation.setRoomNumber(
                                    rs.getString(
                                            "room_number"
                                    )
                            );

                            allocation.setRentAmount(
                                    rs.getBigDecimal(
                                            "rent_amount"
                                    )
                            );

                            return allocation;
                        },
                        id
                );

        if (allocations.isEmpty()) {

            return null;
        }

        return allocations.get(0);
    }

    public boolean hasActiveAllocation(
            int studentId) {

        String sql =
                "SELECT COUNT(*) "
              + "FROM room_allocations "
              + "WHERE student_id = ? "
              + "AND status = 'Active'";

        Integer count =
                jdbcTemplate.queryForObject(
                        sql,
                        Integer.class,
                        studentId
                );

        return count != null && count > 0;
    }

    public boolean updateAllocation(
            RoomAllocation allocation) {

        String sql =
                "UPDATE room_allocations SET "
              + "student_id = ?, "
              + "room_id = ?, "
              + "allocation_date = ?, "
              + "checkout_date = ?, "
              + "status = ? "
              + "WHERE id = ?";

        Date allocationDate = null;
        Date checkoutDate = null;

        if (allocation.getAllocationDate() != null) {

            allocationDate =
                    Date.valueOf(
                            allocation.getAllocationDate()
                    );
        }

        if (allocation.getCheckoutDate() != null) {

            checkoutDate =
                    Date.valueOf(
                            allocation.getCheckoutDate()
                    );
        }

        int rows =
                jdbcTemplate.update(
                        sql,
                        allocation.getStudentId(),
                        allocation.getRoomId(),
                        allocationDate,
                        checkoutDate,
                        allocation.getStatus(),
                        allocation.getId()
                );

        return rows > 0;
    }

    public boolean deleteAllocation(
            int id) {

        String sql =
                "DELETE FROM room_allocations "
              + "WHERE id = ?";

        int rows =
                jdbcTemplate.update(
                        sql,
                        id
                );

        return rows > 0;
    }
}