<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">

    <title>Payment History</title>

</head>

<body>

    <h2>Payment History</h2>


    <!-- =====================================================
         ALLOCATION INFORMATION
         ===================================================== -->

    <p>

        Allocation ID:

        <strong>
            ${allocationId}
        </strong>

    </p>


    <c:if test="${not empty payments}">

        <p>

            Student Name:

            <strong>
                ${payments[0].studentName}
            </strong>

        </p>


        <p>

            Room Number:

            <strong>
                ${payments[0].roomNumber}
            </strong>

        </p>

    </c:if>


    <!-- =====================================================
         PAYMENT SUMMARY
         ===================================================== -->

    <p>

        Total Payments:

        <strong>
            ${payments.size()}
        </strong>

    </p>


    <p>

        Total Amount Paid:

        <strong>
            ₹ ${totalAmount}
        </strong>

    </p>


    <br>


    <!-- =====================================================
         PAYMENT HISTORY TABLE
         ===================================================== -->

    <c:choose>

        <c:when test="${not empty payments}">

            <table border="1"
                   cellpadding="10"
                   cellspacing="0">

                <thead>

                    <tr>

                        <th>ID</th>

                        <th>Allocation ID</th>

                        <th>Student Name</th>

                        <th>Room Number</th>

                        <th>Amount</th>

                        <th>Payment Date</th>

                        <th>Month/Year</th>

                        <th>Payment Status</th>

                        <th>Actions</th>

                    </tr>

                </thead>


                <tbody>

                    <c:forEach var="payment"
                               items="${payments}">

                        <tr>

                            <td>
                                ${payment.id}
                            </td>

                            <td>
                                ${payment.allocationId}
                            </td>

                            <td>

                                <c:choose>

                                    <c:when test="${not empty payment.studentName}">

                                        ${payment.studentName}

                                    </c:when>

                                    <c:otherwise>

                                        N/A

                                    </c:otherwise>

                                </c:choose>

                            </td>

                            <td>

                                <c:choose>

                                    <c:when test="${not empty payment.roomNumber}">

                                        ${payment.roomNumber}

                                    </c:when>

                                    <c:otherwise>

                                        N/A

                                    </c:otherwise>

                                </c:choose>

                            </td>

                            <td>
                                ₹ ${payment.amount}
                            </td>

                            <td>
                                ${payment.paymentDate}
                            </td>

                            <td>
                                ${payment.monthYear}
                            </td>

                            <td>
                                ${payment.paymentStatus}
                            </td>

                            <td>

                                <a href="${pageContext.request.contextPath}/payment/edit?id=${payment.id}">
                                    Edit
                                </a>

                                &nbsp; | &nbsp;

                                <a href="${pageContext.request.contextPath}/payment/delete?id=${payment.id}"
                                   onclick="return confirm('Are you sure you want to delete this payment?');">
                                    Delete
                                </a>

                            </td>

                        </tr>

                    </c:forEach>

                </tbody>

            </table>

        </c:when>


        <!-- =================================================
             NO PAYMENT HISTORY
             ================================================= -->

        <c:otherwise>

            <p>
                No payment history found for this allocation.
            </p>

        </c:otherwise>

    </c:choose>


    <br>


    <!-- =====================================================
         NAVIGATION
         ===================================================== -->

    <a href="${pageContext.request.contextPath}/payment/list">
        Back to Payment List
    </a>

    <br><br>

    <a href="${pageContext.request.contextPath}/allocation/list">
        Back to Allocation List
    </a>

    <br><br>

    <a href="${pageContext.request.contextPath}/dashboard">
        Back to Dashboard
    </a>

</body>

</html>