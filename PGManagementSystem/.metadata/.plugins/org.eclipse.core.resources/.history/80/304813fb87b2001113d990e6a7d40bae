<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Edit Complaint</title>
</head>
<body>

    <h2>Edit Complaint</h2>

    <form action="${pageContext.request.contextPath}/complaint/update"
          method="post">

        <input type="hidden"
               name="id"
               value="${complaint.id}">


        <label>Student:</label><br>

        <select name="studentId" required>

            <c:forEach var="student"
                       items="${students}">

                <option value="${student.id}"
                    <c:if test="${student.id == complaint.studentId}">
                        selected
                    </c:if>
                >
                    ${student.name} - ${student.email}
                </option>

            </c:forEach>

        </select>

        <br><br>


        <label>Complaint Category:</label><br>

        <select name="category" required>

            <option value="Room"
                <c:if test="${complaint.category == 'Room'}">
                    selected
                </c:if>>
                Room
            </option>

            <option value="Food"
                <c:if test="${complaint.category == 'Food'}">
                    selected
                </c:if>>
                Food
            </option>

            <option value="Electricity"
                <c:if test="${complaint.category == 'Electricity'}">
                    selected
                </c:if>>
                Electricity
            </option>

            <option value="Water"
                <c:if test="${complaint.category == 'Water'}">
                    selected
                </c:if>>
                Water
            </option>

            <option value="Cleanliness"
                <c:if test="${complaint.category == 'Cleanliness'}">
                    selected
                </c:if>>
                Cleanliness
            </option>

            <option value="Other"
                <c:if test="${complaint.category == 'Other'}">
                    selected
                </c:if>>
                Other
            </option>

        </select>

        <br><br>


        <label>Description:</label><br>

        <textarea name="description"
                  rows="5"
                  cols="40"
                  maxlength="255"
                  required>${complaint.description}</textarea>

        <br><br>


        <label>Status:</label><br>

        <select name="status" required>

            <option value="Pending"
                <c:if test="${complaint.status == 'Pending'}">
                    selected
                </c:if>>
                Pending
            </option>

            <option value="In Progress"
                <c:if test="${complaint.status == 'In Progress'}">
                    selected
                </c:if>>
                In Progress
            </option>

            <option value="Resolved"
                <c:if test="${complaint.status == 'Resolved'}">
                    selected
                </c:if>>
                Resolved
            </option>

        </select>

        <br><br>


        <label>Created Date:</label><br>

        <input type="date"
               value="${complaint.createdAt}"
               readonly>

        <br><br>


        <button type="submit">
            Update Complaint
        </button>

    </form>

    <br>

    <a href="${pageContext.request.contextPath}/complaint/list">
        Back to Complaint List
    </a>

</body>
</html>