<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Property List</title>
</head>
<body>

    <h2>Property List</h2>

    <br>

    <a href="${pageContext.request.contextPath}/property/add">
        Add New Property
    </a>

    <br><br>

    <p>Total Properties: ${properties.size()}</p>

    <table border="1" cellpadding="10" cellspacing="0">

        <thead>
            <tr>
                <th>ID</th>
                <th>Property Name</th>
                <th>Address</th>
                <th>Owner Name</th>
                <th>Contact Number</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            <c:forEach var="property" items="${properties}">

                <tr>

                    <td>${property.id}</td>

                    <td>${property.propertyName}</td>

                    <td>${property.address}</td>

                    <td>${property.ownerName}</td>

                    <td>${property.contactNumber}</td>

                    <td>

                        <a href="${pageContext.request.contextPath}/property/edit?id=${property.id}">
                            Edit
                        </a>

                        &nbsp; | &nbsp;

                        <a href="${pageContext.request.contextPath}/property/delete?id=${property.id}"
                           onclick="return confirm('Are you sure you want to delete this property?');">
                            Delete
                        </a>

                    </td>

                </tr>

            </c:forEach>

        </tbody>

    </table>

</body>
</html>