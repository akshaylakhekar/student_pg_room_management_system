package com.pgmanagement.dao;

import java.util.List;

import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Repository;

import com.pgmanagement.model.Student;

@Repository
public class StudentDAO {

    private final JdbcTemplate jdbcTemplate;

    public StudentDAO(JdbcTemplate jdbcTemplate) {
        this.jdbcTemplate = jdbcTemplate;
    }

    // Student ko database me save karta hai
    public boolean addStudent(Student student) {

        String sql = "INSERT INTO students "
                   + "(name, email, mobile, guardian_mobile, address, id_proof) "
                   + "VALUES (?, ?, ?, ?, ?, ?)";

        int rows = jdbcTemplate.update(
                sql,
                student.getName(),
                student.getEmail(),
                student.getMobile(),
                student.getGuardianMobile(),
                student.getAddress(),
                student.getIdProof()
        );

        return rows > 0;
    }

    // Saare students database se fetch karta hai
    public List<Student> getAllStudents() {

        String sql = "SELECT * FROM students ORDER BY id DESC";

        return jdbcTemplate.query(
                sql,
                (rs, rowNum) -> {

                    Student student = new Student();

                    student.setId(rs.getInt("id"));
                    student.setName(rs.getString("name"));
                    student.setEmail(rs.getString("email"));
                    student.setMobile(rs.getString("mobile"));
                    student.setGuardianMobile(
                            rs.getString("guardian_mobile")
                    );
                    student.setAddress(
                            rs.getString("address")
                    );
                    student.setIdProof(
                            rs.getString("id_proof")
                    );

                    return student;
                }
        );
    }

    // Student ko ID ke basis par fetch karta hai
    public Student getStudentById(int id) {

        String sql = "SELECT * FROM students WHERE id = ?";

        return jdbcTemplate.queryForObject(
                sql,
                (rs, rowNum) -> {

                    Student student = new Student();

                    student.setId(rs.getInt("id"));
                    student.setName(rs.getString("name"));
                    student.setEmail(rs.getString("email"));
                    student.setMobile(rs.getString("mobile"));
                    student.setGuardianMobile(
                            rs.getString("guardian_mobile")
                    );
                    student.setAddress(
                            rs.getString("address")
                    );
                    student.setIdProof(
                            rs.getString("id_proof")
                    );

                    return student;
                },
                id
        );
    }

    // Student ko update karta hai
    public boolean updateStudent(Student student) {

        String sql = "UPDATE students SET "
                   + "name = ?, "
                   + "email = ?, "
                   + "mobile = ?, "
                   + "guardian_mobile = ?, "
                   + "address = ?, "
                   + "id_proof = ? "
                   + "WHERE id = ?";

        int rows = jdbcTemplate.update(
                sql,
                student.getName(),
                student.getEmail(),
                student.getMobile(),
                student.getGuardianMobile(),
                student.getAddress(),
                student.getIdProof(),
                student.getId()
        );

        return rows > 0;
    }

    // Student ko delete karta hai
    public boolean deleteStudent(int id) {

        String sql = "DELETE FROM students WHERE id = ?";

        int rows = jdbcTemplate.update(sql, id);

        return rows > 0;
    }
}