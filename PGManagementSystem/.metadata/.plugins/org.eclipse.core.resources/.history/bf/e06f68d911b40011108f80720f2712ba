<%@ page contentType="text/html;charset=UTF-8" %>

<!DOCTYPE html>
<html>
<head>

    <meta charset="UTF-8">

    <title>PG Management System</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            color: #172033;
            background:
                radial-gradient(circle at 10% 10%, #dbeafe 0, transparent 28%),
                radial-gradient(circle at 90% 15%, #fce7f3 0, transparent 30%),
                linear-gradient(135deg, #f8fbff, #eef6ff);
            min-height: 100vh;
        }

        /* ================= NAVBAR ================= */

        .navbar {
            background: linear-gradient(90deg, #4f46e5, #7c3aed, #db2777);
            color: white;
            padding: 17px 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 5px 20px rgba(79, 70, 229, 0.25);
        }

        .brand {
            font-size: 22px;
            font-weight: bold;
            letter-spacing: .3px;
        }

        .brand span {
            color: #fde68a;
        }

        .nav-links {
            display: flex;
            gap: 10px;
        }

        .nav-links a {
            color: white;
            text-decoration: none;
            padding: 10px 17px;
            border-radius: 25px;
            font-size: 13px;
            font-weight: bold;
            transition: .25s;
        }

        .admin-link {
            background: rgba(255,255,255,.18);
            border: 1px solid rgba(255,255,255,.35);
        }

        .student-link {
            background: #22c55e;
            box-shadow: 0 4px 12px rgba(34,197,94,.3);
        }

        .nav-links a:hover {
            transform: translateY(-2px);
            background: white;
            color: #4f46e5;
        }

        /* ================= HERO ================= */

        .hero {
            width: 94%;
            max-width: 1150px;
            margin: 50px auto 35px;
            padding: 65px 40px;
            text-align: center;
            border-radius: 25px;
            position: relative;
            overflow: hidden;

            background:
                linear-gradient(
                    135deg,
                    rgba(255,255,255,.97),
                    rgba(239,246,255,.97)
                );

            border: 1px solid #bfdbfe;
            box-shadow: 0 15px 45px rgba(59,130,246,.14);
        }

        .hero::before {
            content: "";
            position: absolute;
            width: 230px;
            height: 230px;
            background: #ddd6fe;
            border-radius: 50%;
            top: -110px;
            left: -90px;
            opacity: .55;
        }

        .hero::after {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            background: #fbcfe8;
            border-radius: 50%;
            bottom: -150px;
            right: -90px;
            opacity: .55;
        }

        .hero > * {
            position: relative;
            z-index: 2;
        }

        .hero-icon {
            width: 90px;
            height: 90px;
            margin: 0 auto 22px;

            background:
                linear-gradient(135deg, #4f46e5, #7c3aed, #ec4899);

            color: white;
            border-radius: 25px;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 30px;
            font-weight: bold;

            box-shadow:
                0 10px 25px rgba(124,58,237,.3);

            transform: rotate(-3deg);
        }

        .hero h1 {
            margin: 0 0 14px;
            font-size: 38px;
            background: linear-gradient(
                90deg,
                #4338ca,
                #7c3aed,
                #db2777
            );
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero p {
            max-width: 750px;
            margin: 0 auto;
            color: #64748b;
            line-height: 1.8;
            font-size: 16px;
        }

        /* ================= LOGIN SECTION ================= */

        .login-section {
            width: 94%;
            max-width: 900px;
            margin: 0 auto 45px;
        }

        .login-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
        }

        .login-card {
            background: rgba(255,255,255,.96);
            border-radius: 20px;
            padding: 32px;
            text-align: center;

            box-shadow: 0 10px 30px rgba(15,23,42,.08);

            transition: .3s;
            position: relative;
            overflow: hidden;
        }

        .login-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
        }

        .admin-card::before {
            background: linear-gradient(
                90deg,
                #4f46e5,
                #9333ea
            );
        }

        .student-card::before {
            background: linear-gradient(
                90deg,
                #16a34a,
                #22c55e
            );
        }

        .login-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 18px 40px rgba(15,23,42,.13);
        }

        .login-card-icon {
            width: 65px;
            height: 65px;
            margin: 0 auto 17px;
            border-radius: 20px;

            display: flex;
            align-items: center;
            justify-content: center;

            color: white;
            font-size: 25px;
            font-weight: bold;
        }

        .admin-icon {
            background: linear-gradient(
                135deg,
                #4f46e5,
                #9333ea
            );

            box-shadow:
                0 8px 20px rgba(79,70,229,.3);
        }

        .student-icon {
            background: linear-gradient(
                135deg,
                #16a34a,
                #22c55e
            );

            box-shadow:
                0 8px 20px rgba(34,197,94,.3);
        }

        .login-card h2 {
            margin: 0 0 9px;
            font-size: 22px;
        }

        .login-card p {
            margin: 0 0 22px;
            color: #64748b;
            font-size: 14px;
            line-height: 1.6;
        }

        .login-btn {
            display: inline-block;
            color: white;
            text-decoration: none;
            padding: 12px 27px;
            border-radius: 25px;
            font-size: 14px;
            font-weight: bold;
            transition: .25s;
        }

        .admin-btn {
            background: linear-gradient(
                90deg,
                #4f46e5,
                #7c3aed
            );

            box-shadow:
                0 6px 16px rgba(79,70,229,.25);
        }

        .student-btn {
            background: linear-gradient(
                90deg,
                #16a34a,
                #22c55e
            );

            box-shadow:
                0 6px 16px rgba(34,197,94,.25);
        }

        .login-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 22px rgba(0,0,0,.18);
        }

        /* ================= FEATURES ================= */

        .features {
            width: 94%;
            max-width: 1150px;
            margin: 0 auto 45px;
        }

        .features h2 {
            text-align: center;
            margin-bottom: 25px;
            font-size: 25px;
            color: #1e293b;
        }

        .features h2 span {
            color: #7c3aed;
        }

        .feature-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
        }

        .feature {
            background: white;
            border-radius: 16px;
            padding: 24px 18px;
            text-align: center;

            box-shadow: 0 7px 20px rgba(15,23,42,.07);

            transition: .3s;
        }

        .feature:hover {
            transform: translateY(-6px);
            box-shadow: 0 14px 30px rgba(15,23,42,.12);
        }

        .feature-icon {
            width: 52px;
            height: 52px;
            margin: 0 auto 14px;
            border-radius: 15px;

            display: flex;
            align-items: center;
            justify-content: center;

            color: white;
            font-weight: bold;
            font-size: 19px;
        }

        .feature:nth-child(1) .feature-icon {
            background: linear-gradient(135deg,#2563eb,#06b6d4);
        }

        .feature:nth-child(2) .feature-icon {
            background: linear-gradient(135deg,#f97316,#facc15);
        }

        .feature:nth-child(3) .feature-icon {
            background: linear-gradient(135deg,#16a34a,#14b8a6);
        }

        .feature:nth-child(4) .feature-icon {
            background: linear-gradient(135deg,#db2777,#9333ea);
        }

        .feature h3 {
            margin: 0 0 8px;
            font-size: 17px;
        }

        .feature p {
            margin: 0;
            color: #64748b;
            font-size: 12px;
            line-height: 1.6;
        }

        /* ================= FOOTER ================= */

        .footer {
            text-align: center;
            color: #64748b;
            font-size: 13px;
            padding: 28px 10px;
            background: rgba(255,255,255,.7);
            border-top: 1px solid #e2e8f0;
        }

        .footer strong {
            color: #7c3aed;
        }

        /* ================= RESPONSIVE ================= */

        @media (max-width: 850px) {

            .feature-grid {
                grid-template-columns: repeat(2, 1fr);
            }

        }

        @media (max-width: 650px) {

            .navbar {
                padding: 16px 18px;
                flex-direction: column;
                gap: 13px;
            }

            .hero {
                padding: 45px 22px;
                margin-top: 30px;
            }

            .hero h1 {
                font-size: 28px;
            }

            .hero p {
                font-size: 14px;
            }

            .login-grid {
                grid-template-columns: 1fr;
            }

            .feature-grid {
                grid-template-columns: 1fr;
            }

            .nav-links {
                width: 100%;
                justify-content: center;
            }

        }

    </style>

</head>

<body>


    <!-- ================= NAVBAR ================= -->

    <div class="navbar">

        <div class="brand">
            🏠 PG <span>Management System</span>
        </div>

        <div class="nav-links">

            <a
                href="${pageContext.request.contextPath}/admin/login"
                class="admin-link">

                🔐 Admin Login

            </a>

            <a
                href="${pageContext.request.contextPath}/student/login"
                class="student-link">

                🎓 Student Login

            </a>

        </div>

    </div>


    <!-- ================= HERO ================= -->

    <div class="hero">

        <div class="hero-icon">
            PG
        </div>

        <h1>
            Welcome to PG Management System
        </h1>

        <p>

            A complete digital solution to manage students,
            properties, rooms, allocations, rent payments,
            complaints and visitors — all in one place.

        </p>

    </div>


    <!-- ================= LOGIN ================= -->

    <div class="login-section">

        <div class="login-grid">


            <!-- ADMIN -->

            <div class="login-card admin-card">

                <div class="login-card-icon admin-icon">
                    A
                </div>

                <h2>
                    Admin Portal
                </h2>

                <p>

                    Manage students, properties, rooms,
                    allocations, payments, complaints
                    and visitors with complete control.

                </p>

                <a
                    href="${pageContext.request.contextPath}/admin/login"
                    class="login-btn admin-btn">

                    🔐 Login as Admin

                </a>

            </div>


            <!-- STUDENT -->

            <div class="login-card student-card">

                <div class="login-card-icon student-icon">
                    S
                </div>

                <h2>
                    Student Portal
                </h2>

                <p>

                    View your profile, room allocation,
                    rent details, complaints and visitor
                    records easily.

                </p>

                <a
                    href="${pageContext.request.contextPath}/student/login"
                    class="login-btn student-btn">

                    🎓 Login as Student

                </a>

            </div>


        </div>

    </div>


    <!-- ================= FEATURES ================= -->

    <div class="features">

        <h2>
            ✨ System <span>Features</span>
        </h2>

        <div class="feature-grid">


            <div class="feature">

                <div class="feature-icon">
                    👨
                </div>

                <h3>
                    Students
                </h3>

                <p>
                    Student registration,
                    profiles and account management.
                </p>

            </div>


            <div class="feature">

                <div class="feature-icon">
                    🏠
                </div>

                <h3>
                    Rooms
                </h3>

                <p>
                    Manage rooms, rent,
                    capacity and availability.
                </p>

            </div>


            <div class="feature">

                <div class="feature-icon">
                    ₹
                </div>

                <h3>
                    Payments
                </h3>

                <p>
                    Track rent payments,
                    history and receipts.
                </p>

            </div>


            <div class="feature">

                <div class="feature-icon">
                    💬
                </div>

                <h3>
                    Complaints
                </h3>

                <p>
                    Submit, track and manage
                    student complaints.
                </p>

            </div>


        </div>

    </div>


    <!-- ================= FOOTER ================= -->

    <div class="footer">

        🏠 <strong>PG Management System</strong>
        &nbsp;•&nbsp;
        Secure • Simple • Smart

        <br><br>

        © 2026 PG Management System

    </div>


</body>
</html>
```
