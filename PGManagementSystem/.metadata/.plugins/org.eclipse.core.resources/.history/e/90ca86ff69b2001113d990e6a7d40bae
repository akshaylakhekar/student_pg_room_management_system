<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Add Room Allocation</title>
</head>
<body>

    <h2>Add Room Allocation</h2>

    <form action="${pageContext.request.contextPath}/allocation/save"
          method="post">

        <label>Student:</label><br>

        <select name="studentId" required>

            <option value="">
                -- Select Student --
            </option>

            <c:forEach var="student" items="${students}">

                <option value="${student.id}">
                    ${student.name} - ${student.email}
                </option>

            </c:forEach>

        </select>

        <br><br>


        <label>Room:</label><br>

        <select name="roomId" required>

            <option value="">
                -- Select Room --
            </option>

            <c:forEach var="room" items="${rooms}">

                <option value="${room.id}">
                    Room ${room.roomNumber}
                    - ${room.sharingType}
                    - ₹${room.rentAmount}
                    - ${room.status}
                </option>

            </c:forEach>

        </select>

        <br><br>


        <label>Allocation Date:</label><br>

        <input type="date"
               name="allocationDate"
               required>

        <br><br>


        <label>Checkout Date:</label><br>

        <input type="date"
               name="checkoutDate">

        <br><br>


        <label>Status:</label><br>

        <select name="status" required>

            <option value="Active">
                Active
            </option>

            <option value="Completed">
                Completed
            </option>

            <option value="Cancelled">
                Cancelled
            </option>

        </select>

        <br><br>


        <button type="submit">
            Save Allocation
        </button>

    </form>

    <br>

    <a href="${pageContext.request.contextPath}/allocation/list">
        View Allocation List
    </a>

</body>
</html>