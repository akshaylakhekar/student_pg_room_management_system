<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">

    <title>Add Visitor</title>

</head>

<body>

    <h2>Add Visitor</h2>

    <form action="${pageContext.request.contextPath}/visitor/save"
          method="post">

        <label>Student:</label>

        <select name="studentId"
                required>

            <option value="">
                -- Select Student --
            </option>

            <c:forEach var="student"
                       items="${students}">

                <option value="${student.id}"
                    <c:if test="${visitor.studentId == student.id}">
                        selected
                    </c:if>
                >
                    ${student.name}
                    - ${student.email}
                </option>

            </c:forEach>

        </select>

        <br><br>

        <label>Visitor Name:</label>

        <input type="text"
               name="visitorName"
               value="${visitor.visitorName}"
               required>

        <br><br>

        <label>Relation:</label>

        <input type="text"
               name="relation"
               value="${visitor.relation}"
               placeholder="Example: Father, Mother, Friend">

        <br><br>

        <label>Entry Time:</label>

        <input type="datetime-local"
               name="entryTime"
               value="${visitor.entryTime}"
               required>

        <br><br>

        <label>Exit Time:</label>

        <input type="datetime-local"
               name="exitTime"
               value="${visitor.exitTime}">

        <br><br>

        <button type="submit">
            Save Visitor
        </button>

    </form>

    <br>

    <a href="${pageContext.request.contextPath}/visitor/list">
        Back to Visitor List
    </a>

    <br><br>

    <a href="${pageContext.request.contextPath}/dashboard">
        Back to Dashboard
    </a>

</body>

</html>