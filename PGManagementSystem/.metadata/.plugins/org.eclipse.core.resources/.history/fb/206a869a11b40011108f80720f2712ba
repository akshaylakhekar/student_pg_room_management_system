<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>PG Management System</title>

<style>

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        --primary: #6366f1;
        --secondary: #06b6d4;
        --green: #22c55e;
        --text: #f8fafc;
        --muted: #cbd5e1;
        --glass: rgba(255, 255, 255, 0.10);
        --glass-border: rgba(255, 255, 255, 0.18);
    }

    body {
        font-family: Arial, Helvetica, sans-serif;
        min-height: 100vh;
        color: var(--text);

        background:
            radial-gradient(circle at 10% 20%, rgba(99,102,241,.35), transparent 30%),
            radial-gradient(circle at 90% 15%, rgba(6,182,212,.28), transparent 28%),
            radial-gradient(circle at 80% 85%, rgba(34,197,94,.20), transparent 30%),
            linear-gradient(135deg, #020617, #0f172a 50%, #111827);

        overflow-x: hidden;
    }

    /* =========================
       Animated Background
       ========================= */

    body::before,
    body::after {
        content: "";
        position: fixed;
        width: 350px;
        height: 350px;
        border-radius: 50%;
        filter: blur(70px);
        opacity: .25;
        z-index: -1;
        animation: floatBlob 10s ease-in-out infinite alternate;
    }

    body::before {
        background: #6366f1;
        top: 10%;
        left: -120px;
    }

    body::after {
        background: #06b6d4;
        right: -120px;
        bottom: 5%;
        animation-delay: 2s;
    }

    @keyframes floatBlob {

        0% {
            transform: translate(0, 0) scale(1);
        }

        50% {
            transform: translate(70px, -40px) scale(1.15);
        }

        100% {
            transform: translate(-30px, 50px) scale(.95);
        }
    }

    /* =========================
       Navbar
       ========================= */

    .navbar {
        width: 94%;
        max-width: 1250px;
        margin: 18px auto 0;

        padding: 15px 22px;

        display: flex;
        justify-content: space-between;
        align-items: center;

        background: rgba(15, 23, 42, .55);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);

        border: 1px solid var(--glass-border);
        border-radius: 18px;

        box-shadow:
            0 10px 40px rgba(0,0,0,.25);

        animation: slideDown .8s ease;
    }

    .brand {
        font-size: 21px;
        font-weight: bold;
        letter-spacing: .4px;
    }

    .brand::before {
        content: "◆";
        color: #38bdf8;
        margin-right: 9px;
        animation: pulse 2s infinite;
    }

    .nav-links {
        display: flex;
        gap: 10px;
    }

    .nav-links a {
        color: white;
        text-decoration: none;

        padding: 10px 16px;
        border-radius: 10px;

        font-size: 13px;
        font-weight: bold;

        transition: all .3s ease;
    }

    .admin-link {
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
    }

    .student-link {
        background: linear-gradient(135deg, #16a34a, #22c55e);
    }

    .nav-links a:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0,0,0,.3);
    }

    /* =========================
       Hero
       ========================= */

    .hero {
        width: 94%;
        max-width: 1150px;

        margin: 55px auto 35px;

        padding: 65px 40px;

        text-align: center;

        background: rgba(255,255,255,.09);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);

        border: 1px solid var(--glass-border);
        border-radius: 25px;

        box-shadow:
            0 20px 60px rgba(0,0,0,.28);

        animation: fadeUp 1s ease;
        position: relative;
        overflow: hidden;
    }

    .hero::before {
        content: "";
        position: absolute;
        width: 200px;
        height: 200px;

        border-radius: 50%;

        background: rgba(99,102,241,.18);

        top: -100px;
        right: -80px;

        animation: rotateBlob 8s linear infinite;
    }

    .hero-icon {
        width: 82px;
        height: 82px;

        margin: 0 auto 22px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 24px;

        background:
            linear-gradient(135deg,
                #6366f1,
                #06b6d4);

        color: white;

        font-size: 25px;
        font-weight: bold;

        box-shadow:
            0 12px 35px rgba(99,102,241,.45);

        animation:
            iconFloat 3s ease-in-out infinite,
            pulseGlow 2.5s ease-in-out infinite;
    }

    .hero h1 {
        margin-bottom: 14px;

        font-size: 38px;
        line-height: 1.2;

        background:
            linear-gradient(
                90deg,
                #fff,
                #67e8f9,
                #a5b4fc,
                #fff
            );

        background-size: 250%;

        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;

        animation: gradientText 5s linear infinite;
    }

    .hero p {
        max-width: 730px;

        margin: auto;

        color: var(--muted);

        line-height: 1.8;
        font-size: 15px;
    }

    /* =========================
       Login Cards
       ========================= */

    .login-section {
        width: 94%;
        max-width: 950px;

        margin: 0 auto 45px;
    }

    .login-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 25px;
    }

    .login-card {
        padding: 35px;

        text-align: center;

        background: rgba(255,255,255,.09);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);

        border: 1px solid var(--glass-border);
        border-radius: 20px;

        box-shadow:
            0 15px 45px rgba(0,0,0,.22);

        transition:
            transform .35s ease,
            box-shadow .35s ease,
            border-color .35s ease;

        animation: fadeUp 1s ease backwards;
    }

    .login-card:nth-child(2) {
        animation-delay: .2s;
    }

    .login-card:hover {
        transform: translateY(-10px);

        border-color: rgba(255,255,255,.35);

        box-shadow:
            0 25px 60px rgba(0,0,0,.35);
    }

    .login-card-icon {
        width: 62px;
        height: 62px;

        margin: 0 auto 18px;

        border-radius: 18px;

        display: flex;
        align-items: center;
        justify-content: center;

        color: white;

        font-size: 22px;
        font-weight: bold;

        transition: transform .3s ease;
    }

    .login-card:hover .login-card-icon {
        transform: rotate(8deg) scale(1.08);
    }

    .admin-icon {
        background: linear-gradient(135deg,#6366f1,#8b5cf6);
        box-shadow: 0 10px 30px rgba(99,102,241,.35);
    }

    .student-icon {
        background: linear-gradient(135deg,#16a34a,#22c55e);
        box-shadow: 0 10px 30px rgba(34,197,94,.30);
    }

    .login-card h2 {
        margin-bottom: 10px;
        font-size: 22px;
    }

    .login-card p {
        margin-bottom: 23px;

        color: var(--muted);

        font-size: 14px;
        line-height: 1.6;
    }

    .login-btn {
        display: inline-block;

        color: white;
        text-decoration: none;

        padding: 12px 27px;

        border-radius: 10px;

        font-size: 14px;
        font-weight: bold;

        transition: all .3s ease;
    }

    .admin-btn {
        background: linear-gradient(135deg,#6366f1,#8b5cf6);
    }

    .student-btn {
        background: linear-gradient(135deg,#16a34a,#22c55e);
    }

    .login-btn:hover {
        transform: translateY(-3px) scale(1.03);

        box-shadow:
            0 10px 25px rgba(0,0,0,.3);
    }

    /* =========================
       Features
       ========================= */

    .features {
        width: 94%;
        max-width: 1150px;

        margin: 0 auto 45px;
    }

    .features h2 {
        text-align: center;

        margin-bottom: 25px;

        font-size: 25px;
    }

    .feature-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
    }

    .feature {
        padding: 23px 18px;

        text-align: center;

        background: rgba(255,255,255,.07);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);

        border: 1px solid var(--glass-border);
        border-radius: 16px;

        transition: all .35s ease;

        animation: fadeUp 1s ease backwards;
    }

    .feature:nth-child(2) {
        animation-delay: .1s;
    }

    .feature:nth-child(3) {
        animation-delay: .2s;
    }

    .feature:nth-child(4) {
        animation-delay: .3s;
    }

    .feature:hover {
        transform: translateY(-7px);

        background: rgba(255,255,255,.12);

        box-shadow:
            0 15px 35px rgba(0,0,0,.25);
    }

    .feature-icon {
        width: 48px;
        height: 48px;

        margin: 0 auto 14px;

        border-radius: 14px;

        display: flex;
        align-items: center;
        justify-content: center;

        background: rgba(99,102,241,.15);

        border: 1px solid rgba(129,140,248,.25);

        color: #93c5fd;

        font-weight: bold;

        transition: all .3s ease;
    }

    .feature:hover .feature-icon {
        transform: scale(1.12) rotate(-5deg);

        background: rgba(99,102,241,.28);
    }

    .feature h3 {
        margin-bottom: 8px;
        font-size: 16px;
    }

    .feature p {
        color: var(--muted);

        font-size: 12px;
        line-height: 1.5;
    }

    /* =========================
       Footer
       ========================= */

    .footer {
        width: 94%;
        max-width: 1150px;

        margin: auto;

        padding: 25px 10px;

        text-align: center;

        color: #94a3b8;

        font-size: 13px;

        border-top:
            1px solid rgba(255,255,255,.1);
    }

    /* =========================
       Animations
       ========================= */

    @keyframes fadeUp {

        from {
            opacity: 0;
            transform: translateY(35px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

    }

    @keyframes slideDown {

        from {
            opacity: 0;
            transform: translateY(-30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

    }

    @keyframes iconFloat {

        0%,100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-8px);
        }

    }

    @keyframes pulse {

        0%,100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.15);
        }

    }

    @keyframes pulseGlow {

        0%,100% {
            box-shadow:
                0 10px 30px rgba(99,102,241,.35);
        }

        50% {
            box-shadow:
                0 15px 45px rgba(6,182,212,.55);
        }

    }

    @keyframes gradientText {

        0% {
            background-position: 0%;
        }

        100% {
            background-position: 250%;
        }

    }

    @keyframes rotateBlob {

        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }

    }

    /* =========================
       Responsive
       ========================= */

    @media (max-width: 900px) {

        .feature-grid {
            grid-template-columns: repeat(2, 1fr);
        }

    }

    @media (max-width: 650px) {

        .navbar {
            flex-direction: column;
            gap: 15px;
            text-align: center;
        }

        .nav-links {
            width: 100%;
            justify-content: center;
        }

        .hero {
            margin-top: 35px;
            padding: 45px 22px;
        }

        .hero h1 {
            font-size: 28px;
        }

        .hero p {
            font-size: 14px;
        }

        .login-grid {
            grid-template-columns: 1fr;
        }

        .feature-grid {
            grid-template-columns: 1fr;
        }

    }

    @media (prefers-reduced-motion: reduce) {

        *,
        *::before,
        *::after {
            animation: none !important;
            transition: none !important;
        }

    }

</style>
```

