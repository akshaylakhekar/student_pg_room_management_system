<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Edit Rent Payment</title>
</head>
<body>

    <h2>Edit Rent Payment</h2>

    <form action="${pageContext.request.contextPath}/payment/update"
          method="post">

        <input type="hidden"
               name="id"
               value="${payment.id}">


        <label>Room Allocation:</label><br>

        <select name="allocationId" required>

            <c:forEach var="allocation"
                       items="${allocations}">

                <option value="${allocation.id}"
                    <c:if test="${allocation.id == payment.allocationId}">
                        selected
                    </c:if>
                >
                    Allocation #${allocation.id}
                    - Student ID: ${allocation.studentId}
                    - Room ID: ${allocation.roomId}
                    - Status: ${allocation.status}
                </option>

            </c:forEach>

        </select>

        <br><br>


        <label>Amount:</label><br>

        <input type="number"
               name="amount"
               value="${payment.amount}"
               step="0.01"
               min="0"
               required>

        <br><br>


        <label>Payment Date:</label><br>

        <input type="date"
               name="paymentDate"
               value="${payment.paymentDate}"
               required>

        <br><br>


        <label>Month / Year:</label><br>

        <input type="text"
               name="monthYear"
               value="${payment.monthYear}"
               required>

        <br><br>


        <label>Payment Status:</label><br>

        <select name="paymentStatus" required>

            <option value="Paid"
                <c:if test="${payment.paymentStatus == 'Paid'}">
                    selected
                </c:if>>
                Paid
            </option>

            <option value="Pending"
                <c:if test="${payment.paymentStatus == 'Pending'}">
                    selected
                </c:if>>
                Pending
            </option>

            <option value="Failed"
                <c:if test="${payment.paymentStatus == 'Failed'}">
                    selected
                </c:if>>
                Failed
            </option>

        </select>

        <br><br>


        <button type="submit">
            Update Payment
        </button>

    </form>

    <br>

    <a href="${pageContext.request.contextPath}/payment/list">
        Back to Payment List
    </a>

</body>
</html>