<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Edit Room</title>
</head>
<body>

    <h2>Edit Room</h2>

    <form action="${pageContext.request.contextPath}/room/update"
          method="post">

        <input type="hidden"
               name="id"
               value="${room.id}">

        <label>Property:</label><br>

        <select name="propertyId" required>

            <c:forEach var="property" items="${properties}">

                <option value="${property.id}"
                    <c:if test="${property.id == room.propertyId}">
                        selected
                    </c:if>
                >
                    ${property.propertyName}
                </option>

            </c:forEach>

        </select>

        <br><br>

        <label>Room Number:</label><br>

        <input type="text"
               name="roomNumber"
               value="${room.roomNumber}"
               required>

        <br><br>

        <label>Capacity:</label><br>

        <input type="number"
               name="capacity"
               value="${room.capacity}"
               min="1"
               required>

        <br><br>

        <label>Sharing Type:</label><br>

        <select name="sharingType" required>

            <option value="Single"
                <c:if test="${room.sharingType == 'Single'}">
                    selected
                </c:if>>
                Single
            </option>

            <option value="Double"
                <c:if test="${room.sharingType == 'Double'}">
                    selected
                </c:if>>
                Double
            </option>

            <option value="Triple"
                <c:if test="${room.sharingType == 'Triple'}">
                    selected
                </c:if>>
                Triple
            </option>

            <option value="Four Sharing"
                <c:if test="${room.sharingType == 'Four Sharing'}">
                    selected
                </c:if>>
                Four Sharing
            </option>

        </select>

        <br><br>

        <label>Rent Amount:</label><br>

        <input type="number"
               name="rentAmount"
               value="${room.rentAmount}"
               step="0.01"
               min="0"
               required>

        <br><br>

        <label>Status:</label><br>

        <select name="status" required>

            <option value="Available"
                <c:if test="${room.status == 'Available'}">
                    selected
                </c:if>>
                Available
            </option>

            <option value="Occupied"
                <c:if test="${room.status == 'Occupied'}">
                    selected
                </c:if>>
                Occupied
            </option>

            <option value="Maintenance"
                <c:if test="${room.status == 'Maintenance'}">
                    selected
                </c:if>>
                Maintenance
            </option>

        </select>

        <br><br>

        <button type="submit">
            Update Room
        </button>

    </form>

    <br>

    <a href="${pageContext.request.contextPath}/room/list">
        Back to Room List
    </a>

</body>
</html>