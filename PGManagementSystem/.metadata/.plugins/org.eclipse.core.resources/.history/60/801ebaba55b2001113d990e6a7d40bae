package com.pgmanagement.dao;

import java.sql.Connection;
import java.sql.PreparedStatement;

import com.pgmanagement.model.Student;

public class StudentDAO {

    public boolean addStudent(Student student) {

        String sql = "INSERT INTO students "
                   + "(name, email, mobile, guardian_mobile, address, id_proof) "
                   + "VALUES (?, ?, ?, ?, ?, ?)";

        try (Connection con = DBConnection.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {

            ps.setString(1, student.getName());
            ps.setString(2, student.getEmail());
            ps.setString(3, student.getMobile());
            ps.setString(4, student.getGuardianMobile());
            ps.setString(5, student.getAddress());
            ps.setString(6, student.getIdProof());

            int rows = ps.executeUpdate();

            return rows > 0;

        } catch (Exception e) {
            e.printStackTrace();
            return false;
        }
    }
}