<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">

    <title>Add Complaint</title>

</head>

<body>

    <h2>Add Complaint</h2>

    <c:if test="${not empty errorMessage}">

        <p>
            <strong>${errorMessage}</strong>
        </p>

    </c:if>

    <form action="${pageContext.request.contextPath}/complaint/save"
          method="post">

        <label>Student:</label>

        <select name="studentId"
                required>

            <option value="">
                -- Select Student --
            </option>

            <c:forEach var="student"
                       items="${students}">

                <option value="${student.id}"
                    <c:if test="${complaint.studentId == student.id}">
                        selected
                    </c:if>
                >
                    ${student.name}
                    - ${student.email}
                </option>

            </c:forEach>

        </select>

        <br><br>

        <label>Category:</label>

        <select name="category"
                required>

            <option value="">
                -- Select Category --
            </option>

            <option value="Room"
                <c:if test="${complaint.category == 'Room'}">
                    selected
                </c:if>
            >
                Room
            </option>

            <option value="Food"
                <c:if test="${complaint.category == 'Food'}">
                    selected
                </c:if>
            >
                Food
            </option>

            <option value="Maintenance"
                <c:if test="${complaint.category == 'Maintenance'}">
                    selected
                </c:if>
            >
                Maintenance
            </option>

            <option value="Electricity"
                <c:if test="${complaint.category == 'Electricity'}">
                    selected
                </c:if>
            >
                Electricity
            </option>

            <option value="Water"
                <c:if test="${complaint.category == 'Water'}">
                    selected
                </c:if>
            >
                Water
            </option>

            <option value="Other"
                <c:if test="${complaint.category == 'Other'}">
                    selected
                </c:if>
            >
                Other
            </option>

        </select>

        <br><br>

        <label>Description:</label>

        <br>

        <textarea name="description"
                  rows="5"
                  cols="50"
                  required>${complaint.description}</textarea>

        <br><br>

        <label>Status:</label>

        <select name="status"
                required>

            <option value="">
                -- Select Status --
            </option>

            <option value="Open"
                <c:if test="${complaint.status == 'Open'}">
                    selected
                </c:if>
            >
                Open
            </option>

            <option value="In Progress"
                <c:if test="${complaint.status == 'In Progress'}">
                    selected
                </c:if>
            >
                In Progress
            </option>

            <option value="Resolved"
                <c:if test="${complaint.status == 'Resolved'}">
                    selected
                </c:if>
            >
                Resolved
            </option>

            <option value="Closed"
                <c:if test="${complaint.status == 'Closed'}">
                    selected
                </c:if>
            >
                Closed
            </option>

        </select>

        <br><br>

        <button type="submit">
            Save Complaint
        </button>

    </form>

    <br>

    <a href="${pageContext.request.contextPath}/complaint/list">
        Back to Complaint List
    </a>

    <br><br>

    <a href="${pageContext.request.contextPath}/dashboard">
        Back to Dashboard
    </a>

</body>

</html>