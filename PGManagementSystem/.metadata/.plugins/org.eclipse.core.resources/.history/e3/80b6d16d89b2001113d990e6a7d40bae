<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Edit Room</title>

    <style>
        body {
            margin: 0;
            font-family: Arial;
            background: #f4f7fb;
        }

        .navbar {
            background: #1e293b;
            color: white;
            padding: 18px 40px;
        }

        .container {
            max-width: 750px;
            width: 92%;
            margin: 35px auto;
        }

        .card {
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,.08);
        }

        label {
            display: block;
            font-weight: bold;
            margin: 15px 0 7px;
        }

        input, select {
            width: 100%;
            padding: 11px;
            box-sizing: border-box;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
        }

        button {
            margin-top: 20px;
            padding: 11px 20px;
            background: #2563eb;
            color: white;
            border: none;
            border-radius: 6px;
        }

        .error {
            background: #fee2e2;
            color: #991b1b;
            padding: 12px;
            border-radius: 6px;
        }

        a {
            color: #2563eb;
            text-decoration: none;
        }
    </style>
</head>

<body>

<div class="navbar">
    <h2>PG Management System</h2>
</div>

<div class="container">

<div class="card">

<h1>Edit Room</h1>

<c:if test="${not empty errorMessage}">
    <div class="error">${errorMessage}</div>
</c:if>

<c:choose>

<c:when test="${not empty room}">

<form action="${pageContext.request.contextPath}/room/update"
      method="post">

<input type="hidden"
       name="id"
       value="${room.id}">

<label>Property</label>

<select name="propertyId" required>

<c:forEach var="property" items="${properties}">

<option value="${property.id}"
    <c:if test="${room.propertyId == property.id}">
        selected
    </c:if>
>
    ${property.propertyName}
</option>

</c:forEach>

</select>

<label>Room Number</label>
<input type="text"
       name="roomNumber"
       value="${room.roomNumber}"
       required>

<label>Capacity</label>
<input type="number"
       name="capacity"
       value="${room.capacity}"
       min="1"
       required>

<label>Sharing Type</label>
<input type="text"
       name="sharingType"
       value="${room.sharingType}"
       required>

<label>Rent Amount</label>
<input type="number"
       name="rentAmount"
       value="${room.rentAmount}"
       step="0.01"
       min="0.01"
       required>

<label>Status</label>

<select name="status" required>

<option value="Available"
    <c:if test="${room.status == 'Available'}">
        selected
    </c:if>
>
    Available
</option>

<option value="Occupied"
    <c:if test="${room.status == 'Occupied'}">
        selected
    </c:if>
>
    Occupied
</option>

</select>

<button type="submit">
    Update Room
</button>

</form>

</c:when>

<c:otherwise>
    <p>Room not found.</p>
</c:otherwise>

</c:choose>

<br>

<a href="${pageContext.request.contextPath}/room/list">
    ← Back to Room List
</a>

</div>

</div>

</body>
</html>