<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">

    <title>Visitor List</title>

</head>

<body>

    <h2>Visitor List</h2>

    <a href="${pageContext.request.contextPath}/visitor/add">
        Add New Visitor
    </a>

    <br><br>

    <!-- Search Visitor -->

    <form action="${pageContext.request.contextPath}/visitor/list"
          method="get">

        <label>Search Visitor:</label>

        <input type="text"
               name="keyword"
               value="${keyword}"
               placeholder="Student ID, Visitor Name or Relation">

        <button type="submit">
            Search
        </button>

        <a href="${pageContext.request.contextPath}/visitor/list">
            Clear
        </a>

    </form>

    <br>

    <p>
        Total Visitors: ${visitors.size()}
    </p>

    <table border="1"
           cellpadding="10"
           cellspacing="0">

        <thead>

            <tr>

                <th>ID</th>
                <th>Student ID</th>
                <th>Visitor Name</th>
                <th>Relation</th>
                <th>Entry Time</th>
                <th>Exit Time</th>
                <th>Actions</th>

            </tr>

        </thead>

        <tbody>

            <c:forEach var="visitor"
                       items="${visitors}">

                <tr>

                    <td>
                        ${visitor.id}
                    </td>

                    <td>
                        ${visitor.studentId}
                    </td>

                    <td>
                        ${visitor.visitorName}
                    </td>

                    <td>
                        ${visitor.relation}
                    </td>

                    <td>
                        ${visitor.entryTime}
                    </td>

                    <td>
                        ${visitor.exitTime}
                    </td>

                    <td>

                        <a href="${pageContext.request.contextPath}/visitor/edit?id=${visitor.id}">
                            Edit
                        </a>

                        &nbsp; | &nbsp;

                        <a href="${pageContext.request.contextPath}/visitor/delete?id=${visitor.id}"
                           onclick="return confirm('Are you sure you want to delete this visitor record?');">
                            Delete
                        </a>

                    </td>

                </tr>

            </c:forEach>

        </tbody>

    </table>

    <br>

    <a href="${pageContext.request.contextPath}/dashboard">
        Back to Dashboard
    </a>

</body>

</html>