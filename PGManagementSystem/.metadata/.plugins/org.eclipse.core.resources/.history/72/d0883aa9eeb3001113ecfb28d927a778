<%@ page contentType="text/html;charset=UTF-8" %>

<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">

    <title>Add Complaint - PG Management System</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f7fb;
            color: #1e293b;
        }

        .navbar {
            background: #1e293b;
            color: white;
            padding: 18px 30px;
        }

        .navbar h2 {
            margin: 0;
            font-size: 22px;
        }

        .container {
            width: 90%;
            max-width: 750px;
            margin: 40px auto;
        }

        .card {
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .card h2 {
            margin-top: 0;
            margin-bottom: 25px;
            color: #1e293b;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 7px;
            font-weight: bold;
            color: #334155;
        }

        input,
        select,
        textarea {
            width: 100%;
            padding: 11px 12px;
            border: 1px solid #cbd5e1;
            border-radius: 7px;
            font-size: 14px;
            outline: none;
            font-family: Arial, sans-serif;
        }

        input:focus,
        select:focus,
        textarea:focus {
            border-color: #2563eb;
        }

        input[readonly] {
            background: #f1f5f9;
            color: #475569;
            cursor: not-allowed;
        }

        textarea {
            min-height: 120px;
            resize: vertical;
        }

        .student-info {
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            color: #1e40af;
            padding: 11px 13px;
            border-radius: 7px;
            margin-top: 7px;
            font-size: 13px;
        }

        .buttons {
            display: flex;
            gap: 12px;
            margin-top: 25px;
        }

        .btn {
            display: inline-block;
            padding: 11px 20px;
            border: none;
            border-radius: 7px;
            text-decoration: none;
            font-size: 14px;
            cursor: pointer;
        }

        .btn-primary {
            background: #2563eb;
            color: white;
        }

        .btn-primary:hover {
            background: #1d4ed8;
        }

        .btn-secondary {
            background: #64748b;
            color: white;
        }

        .btn-secondary:hover {
            background: #475569;
        }

        .required {
            color: #dc2626;
        }

        .role-badge {
            display: inline-block;
            margin-bottom: 20px;
            padding: 6px 10px;
            border-radius: 20px;
            background: #e2e8f0;
            color: #475569;
            font-size: 12px;
            font-weight: bold;
        }

        @media (max-width: 600px) {

            .container {
                width: 94%;
                margin: 25px auto;
            }

            .card {
                padding: 20px;
            }

            .buttons {
                flex-direction: column;
            }

            .btn {
                text-align: center;
            }

        }

    </style>

</head>

<body>


    <div class="navbar">

        <h2>
            PG Management System
        </h2>

    </div>


    <div class="container">

        <div class="card">

            <h2>
                Add New Complaint
            </h2>


            <!-- ============================= -->
            <!-- ADMIN / STUDENT ROLE -->
            <!-- ============================= -->

            <c:choose>

                <c:when test="${sessionScope.role == 'ADMIN'}">

                    <div class="role-badge">
                        ADMIN
                    </div>

                </c:when>


                <c:when test="${sessionScope.role == 'STUDENT'}">

                    <div class="role-badge">
                        STUDENT
                    </div>

                </c:when>

            </c:choose>


            <form
                action="${pageContext.request.contextPath}/complaint/save"
                method="post">


                <!-- ============================= -->
                <!-- STUDENT -->
                <!-- ============================= -->

                <div class="form-group">

                    <label>

                        Student
                        <span class="required">*</span>

                    </label>


                    <c:choose>


                        <!-- ================================= -->
                        <!-- ADMIN -->
                        <!-- ================================= -->

                        <c:when test="${sessionScope.role == 'ADMIN'}">

                            <select
                                name="studentId"
                                required>

                                <option value="">
                                    -- Select Student --
                                </option>


                                <c:forEach
                                    var="student"
                                    items="${students}">


                                    <option
                                        value="${student.id}"

                                        <c:if test="${complaint.studentId == student.id}">
                                            selected
                                        </c:if>
                                    >

                                        ${student.name}
                                        -
                                        ${student.email}

                                    </option>


                                </c:forEach>

                            </select>

                        </c:when>


                        <!-- ================================= -->
                        <!-- LOGGED-IN STUDENT -->
                        <!-- ================================= -->

                        <c:when test="${sessionScope.role == 'STUDENT'}">


                            <input
                                type="text"
                                value="${loggedInStudent.name} - ${loggedInStudent.email}"
                                readonly>


                            <!--

                                Hidden ID sirf form compatibility
                                ke liye hai.

                                Actual student ID backend me
                                HttpSession se liya jayega.

                            -->

                            <input
                                type="hidden"
                                name="studentId"
                                value="${loggedInStudent.id}">


                            <div class="student-info">

                                You are submitting this complaint
                                as your own account.

                            </div>


                        </c:when>


                    </c:choose>

                </div>


                <!-- ============================= -->
                <!-- CATEGORY -->
                <!-- ============================= -->

                <div class="form-group">

                    <label>

                        Category
                        <span class="required">*</span>

                    </label>


                    <select
                        name="category"
                        required>


                        <option value="">
                            -- Select Category --
                        </option>


                        <option
                            value="Room"

                            <c:if test="${complaint.category == 'Room'}">
                                selected
                            </c:if>
                        >

                            Room

                        </option>


                        <option
                            value="Food"

                            <c:if test="${complaint.category == 'Food'}">
                                selected
                            </c:if>
                        >

                            Food

                        </option>


                        <option
                            value="Maintenance"

                            <c:if test="${complaint.category == 'Maintenance'}">
                                selected
                            </c:if>
                        >

                            Maintenance

                        </option>


                        <option
                            value="Electricity"

                            <c:if test="${complaint.category == 'Electricity'}">
                                selected
                            </c:if>
                        >

                            Electricity

                        </option>


                        <option
                            value="Water"

                            <c:if test="${complaint.category == 'Water'}">
                                selected
                            </c:if>
                        >

                            Water

                        </option>


                        <option
                            value="Other"

                            <c:if test="${complaint.category == 'Other'}">
                                selected
                            </c:if>
                        >

                            Other

                        </option>


                    </select>

                </div>


                <!-- ============================= -->
                <!-- DESCRIPTION -->
                <!-- ============================= -->

                <div class="form-group">

                    <label>

                        Description
                        <span class="required">*</span>

                    </label>


                    <textarea
                        name="description"
                        placeholder="Enter complaint details..."
                        required>${complaint.description}</textarea>

                </div>


                <!-- ============================= -->
                <!-- STATUS -->
                <!-- ============================= -->

                <c:choose>


                    <!-- ADMIN CAN SELECT STATUS -->

                    <c:when test="${sessionScope.role == 'ADMIN'}">

                        <div class="form-group">

                            <label>

                                Status
                                <span class="required">*</span>

                            </label>


                            <select
                                name="status"
                                required>


                                <option value="">
                                    -- Select Status --
                                </option>


                                <option
                                    value="Pending"

                                    <c:if test="${complaint.status == 'Pending'}">
                                        selected
                                    </c:if>
                                >

                                    Pending

                                </option>


                                <option
                                    value="Open"

                                    <c:if test="${complaint.status == 'Open'}">
                                        selected
                                    </c:if>
                                >

                                    Open

                                </option>


                                <option
                                    value="Resolved"

                                    <c:if test="${complaint.status == 'Resolved'}">
                                        selected
                                    </c:if>
                                >

                                    Resolved

                                </option>


                                <option
                                    value="Closed"

                                    <c:if test="${complaint.status == 'Closed'}">
                                        selected
                                    </c:if>
                                >

                                    Closed

                                </option>


                            </select>

                        </div>

                    </c:when>


                    <!-- STUDENT STATUS -->

                    <c:when test="${sessionScope.role == 'STUDENT'}">

                        <div class="form-group">

                            <label>
                                Status
                            </label>


                            <input
                                type="text"
                                value="Pending"
                                readonly>


                            <div class="student-info">

                                New complaints are automatically
                                submitted with <strong>Pending</strong>
                                status.

                            </div>

                        </div>

                    </c:when>


                </c:choose>


                <!-- ============================= -->
                <!-- BUTTONS -->
                <!-- ============================= -->

                <div class="buttons">


                    <button
                        type="submit"
                        class="btn btn-primary">

                        Save Complaint

                    </button>


                    <c:choose>


                        <c:when test="${sessionScope.role == 'STUDENT'}">

                            <a
                                href="${pageContext.request.contextPath}/complaint/student?studentId=${loggedInStudent.id}"
                                class="btn btn-secondary">

                                Cancel

                            </a>

                        </c:when>


                        <c:otherwise>

                            <a
                                href="${pageContext.request.contextPath}/complaint/list"
                                class="btn btn-secondary">

                                Cancel

                            </a>

                        </c:otherwise>


                    </c:choose>


                </div>


            </form>

        </div>

    </div>


</body>

</html>