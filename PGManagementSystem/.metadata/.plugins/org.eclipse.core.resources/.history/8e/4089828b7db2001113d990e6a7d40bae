<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">

    <title>Student Profile</title>

</head>

<body>

    <h2>Student Profile</h2>

    <c:choose>

        <c:when test="${not empty student}">

            <h3>Student Information</h3>

            <table border="1"
                   cellpadding="10"
                   cellspacing="0">

                <tr>
                    <th>Student ID</th>
                    <td>${student.id}</td>
                </tr>

                <tr>
                    <th>Name</th>
                    <td>${student.name}</td>
                </tr>

                <tr>
                    <th>Email</th>
                    <td>${student.email}</td>
                </tr>

                <tr>
                    <th>Mobile</th>
                    <td>${student.mobile}</td>
                </tr>

                <tr>
                    <th>Guardian Mobile</th>
                    <td>${student.guardianMobile}</td>
                </tr>

                <tr>
                    <th>Address</th>
                    <td>${student.address}</td>
                </tr>

                <tr>
                    <th>ID Proof</th>
                    <td>${student.idProof}</td>
                </tr>

            </table>

            <br>

            <h3>Current Room Details</h3>

            <c:choose>

                <c:when test="${not empty currentAllocation}">

                    <table border="1"
                           cellpadding="10"
                           cellspacing="0">

                        <tr>
                            <th>Allocation ID</th>
                            <td>
                                ${currentAllocation.id}
                            </td>
                        </tr>

                        <tr>
                            <th>Room ID</th>
                            <td>
                                ${currentAllocation.roomId}
                            </td>
                        </tr>

                        <tr>
                            <th>Room Number</th>
                            <td>
                                ${currentAllocation.roomNumber}
                            </td>
                        </tr>

                        <tr>
                            <th>Monthly Rent</th>
                            <td>
                                ₹ ${currentAllocation.rentAmount}
                            </td>
                        </tr>

                        <tr>
                            <th>Allocation Date</th>
                            <td>
                                ${currentAllocation.allocationDate}
                            </td>
                        </tr>

                        <tr>
                            <th>Status</th>
                            <td>
                                ${currentAllocation.status}
                            </td>
                        </tr>

                    </table>

                    <br>

                    <a href="${pageContext.request.contextPath}/payment/add?allocationId=${currentAllocation.id}">
                        Add Rent Payment
                    </a>

                    &nbsp; | &nbsp;

                    <a href="${pageContext.request.contextPath}/payment/history?allocationId=${currentAllocation.id}">
                        View Payment History
                    </a>

                </c:when>

                <c:otherwise>

                    <p>
                        No active room allocation found.
                    </p>

                </c:otherwise>

            </c:choose>

            <br><br>

            <h3>Student Actions</h3>

            <a href="${pageContext.request.contextPath}/complaint/add?studentId=${student.id}">
                Add Complaint
            </a>

            &nbsp; | &nbsp;

            <a href="${pageContext.request.contextPath}/complaint/student?studentId=${student.id}">
                View Complaints
            </a>

            &nbsp; | &nbsp;

            <a href="${pageContext.request.contextPath}/visitor/add?studentId=${student.id}">
                Add Visitor
            </a>

            &nbsp; | &nbsp;

            <a href="${pageContext.request.contextPath}/visitor/student?studentId=${student.id}">
                View Visitors
            </a>

            <br><br>

            <a href="${pageContext.request.contextPath}/student/edit?id=${student.id}">
                Edit Student
            </a>

            <br><br>

            <a href="${pageContext.request.contextPath}/student/list">
                Back to Student List
            </a>

            <br><br>

            <a href="${pageContext.request.contextPath}/dashboard">
                Back to Dashboard
            </a>

        </c:when>

        <c:otherwise>

            <p>
                Student not found.
            </p>

            <br>

            <a href="${pageContext.request.contextPath}/student/list">
                Back to Student List
            </a>

        </c:otherwise>

    </c:choose>

</body>

</html>