<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Edit Visitor</title>
</head>
<body>

    <h2>Edit Visitor</h2>

    <form action="${pageContext.request.contextPath}/visitor/update"
          method="post">

        <input type="hidden"
               name="id"
               value="${visitor.id}">


        <label>Student:</label><br>

        <select name="studentId" required>

            <c:forEach var="student"
                       items="${students}">

                <option value="${student.id}"
                    <c:if test="${student.id == visitor.studentId}">
                        selected
                    </c:if>
                >
                    ${student.name} - ${student.email}
                </option>

            </c:forEach>

        </select>

        <br><br>


        <label>Visitor Name:</label><br>

        <input type="text"
               name="visitorName"
               value="${visitor.visitorName}"
               maxlength="100"
               required>

        <br><br>


        <label>Relation:</label><br>

        <input type="text"
               name="relation"
               value="${visitor.relation}"
               maxlength="50">

        <br><br>


        <label>Entry Time:</label><br>

        <input type="datetime-local"
               name="entryTime"
               value="${visitor.entryTime}"
               required>

        <br><br>


        <label>Exit Time:</label><br>

        <input type="datetime-local"
               name="exitTime"
               value="${visitor.exitTime}">

        <br><br>


        <button type="submit">
            Update Visitor
        </button>

    </form>

    <br>

    <a href="${pageContext.request.contextPath}/visitor/list">
        Back to Visitor List
    </a>

</body>
</html>