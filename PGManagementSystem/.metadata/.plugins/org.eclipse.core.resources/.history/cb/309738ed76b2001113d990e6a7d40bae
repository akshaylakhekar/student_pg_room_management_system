<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">

    <title>Rent Payment List</title>

</head>

<body>

    <h2>Rent Payment List</h2>


    <!-- =====================================================
         ADD PAYMENT
         ===================================================== -->

    <a href="${pageContext.request.contextPath}/payment/add">
        Add New Payment
    </a>

    <br><br>


    <!-- =====================================================
         SEARCH
         ===================================================== -->

    <form action="${pageContext.request.contextPath}/payment/list"
          method="get">

        <label>Search Payment:</label>

        <input type="text"
               name="keyword"
               value="${keyword}"
               placeholder="Student, Room, Allocation ID, Amount, Month/Year or Status">

        <button type="submit">
            Search
        </button>

        <a href="${pageContext.request.contextPath}/payment/list">
            Clear
        </a>

    </form>

    <br>


    <!-- =====================================================
         TOTAL PAYMENTS
         ===================================================== -->

    <p>

        Total Payments:
        <strong>${payments.size()}</strong>

    </p>


    <!-- =====================================================
         PAYMENT TABLE
         ===================================================== -->

    <c:choose>

        <c:when test="${not empty payments}">

            <table border="1"
                   cellpadding="10"
                   cellspacing="0">

                <thead>

                    <tr>

                        <th>ID</th>

                        <th>Allocation ID</th>

                        <th>Student Name</th>

                        <th>Room Number</th>

                        <th>Amount</th>

                        <th>Payment Date</th>

                        <th>Month/Year</th>

                        <th>Payment Status</th>

                        <th>Actions</th>

                    </tr>

                </thead>


                <tbody>

                    <c:forEach var="payment"
                               items="${payments}">

                        <tr>

                            <!-- Payment ID -->

                            <td>
                                ${payment.id}
                            </td>


                            <!-- Allocation ID -->

                            <td>
                                ${payment.allocationId}
                            </td>


                            <!-- Student Name -->

                            <td>

                                <c:choose>

                                    <c:when test="${not empty payment.studentName}">

                                        ${payment.studentName}

                                    </c:when>

                                    <c:otherwise>

                                        N/A

                                    </c:otherwise>

                                </c:choose>

                            </td>


                            <!-- Room Number -->

                            <td>

                                <c:choose>

                                    <c:when test="${not empty payment.roomNumber}">

                                        ${payment.roomNumber}

                                    </c:when>

                                    <c:otherwise>

                                        N/A

                                    </c:otherwise>

                                </c:choose>

                            </td>


                            <!-- Amount -->

                            <td>
                                ${payment.amount}
                            </td>


                            <!-- Payment Date -->

                            <td>
                                ${payment.paymentDate}
                            </td>


                            <!-- Month / Year -->

                            <td>
                                ${payment.monthYear}
                            </td>


                            <!-- Payment Status -->

                            <td>
                                ${payment.paymentStatus}
                            </td>


                            <!-- Actions -->

                            <td>

                                <a href="${pageContext.request.contextPath}/payment/history?allocationId=${payment.allocationId}">
                                    History
                                </a>

                                &nbsp; | &nbsp;

                                <a href="${pageContext.request.contextPath}/payment/edit?id=${payment.id}">
                                    Edit
                                </a>

                                &nbsp; | &nbsp;

                                <a href="${pageContext.request.contextPath}/payment/delete?id=${payment.id}"
                                   onclick="return confirm('Are you sure you want to delete this payment?');">
                                    Delete
                                </a>

                            </td>

                        </tr>

                    </c:forEach>

                </tbody>

            </table>

        </c:when>


        <!-- =================================================
             NO PAYMENTS
             ================================================= -->

        <c:otherwise>

            <p>
                No rent payments found.
            </p>

        </c:otherwise>

    </c:choose>


    <br>


    <!-- =====================================================
         NAVIGATION
         ===================================================== -->

    <a href="${pageContext.request.contextPath}/dashboard">
        Back to Dashboard
    </a>

</body>

</html>