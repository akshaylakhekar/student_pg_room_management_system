<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Rent Payment List</title>
</head>
<body>

    <h2>Rent Payment List</h2>

    <br>

    <a href="${pageContext.request.contextPath}/payment/add">
        Add New Payment
    </a>

    <br><br>

    <p>Total Payments: ${payments.size()}</p>

    <table border="1" cellpadding="10" cellspacing="0">

        <thead>
            <tr>
                <th>ID</th>
                <th>Allocation ID</th>
                <th>Amount</th>
                <th>Payment Date</th>
                <th>Month / Year</th>
                <th>Payment Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            <c:forEach var="payment" items="${payments}">

                <tr>

                    <td>${payment.id}</td>

                    <td>${payment.allocationId}</td>

                    <td>₹${payment.amount}</td>

                    <td>${payment.paymentDate}</td>

                    <td>${payment.monthYear}</td>

                    <td>${payment.paymentStatus}</td>

                    <td>

                        <a href="${pageContext.request.contextPath}/payment/edit?id=${payment.id}">
                            Edit
                        </a>

                        &nbsp; | &nbsp;

                        <a href="${pageContext.request.contextPath}/payment/delete?id=${payment.id}"
                           onclick="return confirm('Are you sure you want to delete this payment?');">
                            Delete
                        </a>

                    </td>

                </tr>

            </c:forEach>

        </tbody>

    </table>

</body>
</html>