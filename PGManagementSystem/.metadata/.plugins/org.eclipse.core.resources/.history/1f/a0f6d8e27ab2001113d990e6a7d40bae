<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Add Visitor</title>
</head>
<body>

    <h2>Add Visitor</h2>

    <form action="${pageContext.request.contextPath}/visitor/save"
          method="post">

        <label>Student:</label><br>

        <select name="studentId" required>

            <option value="">
                -- Select Student --
            </option>

            <c:forEach var="student"
                       items="${students}">

                <option value="${student.id}">
                    ${student.name} - ${student.email}
                </option>

            </c:forEach>

        </select>

        <br><br>


        <label>Visitor Name:</label><br>

        <input type="text"
               name="visitorName"
               maxlength="100"
               required>

        <br><br>


        <label>Relation:</label><br>

        <input type="text"
               name="relation"
               maxlength="50"
               placeholder="Example: Father, Brother, Friend">

        <br><br>


        <label>Entry Time:</label><br>

        <input type="datetime-local"
               name="entryTime">

        <br><br>


        <label>Exit Time:</label><br>

        <input type="datetime-local"
               name="exitTime">

        <br><br>


        <button type="submit">
            Save Visitor
        </button>

    </form>

    <br>

    <a href="${pageContext.request.contextPath}/visitor/list">
        View Visitor List
    </a>

</body>
</html>