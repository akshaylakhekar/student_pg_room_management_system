<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Properties</title>

    <style>
        body {
            margin: 0;
            font-family: Arial;
            background: #f4f7fb;
        }

        .navbar {
            background: #1e293b;
            color: white;
            padding: 18px 40px;
            display: flex;
            justify-content: space-between;
        }

        .navbar a {
            color: white;
            text-decoration: none;
            margin-left: 20px;
        }

        .container {
            width: 94%;
            max-width: 1250px;
            margin: 35px auto;
        }

        .top {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .button {
            background: #2563eb;
            color: white;
            padding: 11px 16px;
            text-decoration: none;
            border-radius: 6px;
        }

        .search, .table-box {
            background: white;
            padding: 20px;
            border-radius: 10px;
            margin-top: 20px;
        }

        input {
            padding: 10px;
            width: 300px;
            max-width: 100%;
        }

        button {
            padding: 10px 16px;
            background: #2563eb;
            color: white;
            border: none;
            border-radius: 6px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background: #1e293b;
            color: white;
            padding: 12px;
            text-align: left;
        }

        td {
            padding: 11px;
            border-bottom: 1px solid #ddd;
        }

        td a {
            color: #2563eb;
            margin-right: 10px;
        }

        .error {
            background: #fee2e2;
            color: #991b1b;
            padding: 12px;
            margin-top: 15px;
            border-radius: 6px;
        }
    </style>
</head>

<body>

<div class="navbar">
    <h2>PG Management System</h2>

    <div>
        <a href="${pageContext.request.contextPath}/dashboard">Dashboard</a>
        <a href="${pageContext.request.contextPath}/">Home</a>
    </div>
</div>

<div class="container">

<div class="top">

    <div>
        <h1>Property Management</h1>
        <p>Total Properties: <strong>${properties.size()}</strong></p>
    </div>

    <a class="button"
       href="${pageContext.request.contextPath}/property/add">
        + Add Property
    </a>

</div>

<c:if test="${not empty errorMessage}">
    <div class="error">${errorMessage}</div>
</c:if>

<div class="search">

<form action="${pageContext.request.contextPath}/property/list"
      method="get">

    <input type="text"
           name="keyword"
           value="${keyword}"
           placeholder="Search property">

    <button type="submit">Search</button>

    <a href="${pageContext.request.contextPath}/property/list">
        Clear
    </a>

</form>

</div>

<div class="table-box">

<c:choose>

<c:when test="${not empty properties}">

<table>

<tr>
    <th>ID</th>
    <th>Property Name</th>
    <th>Address</th>
    <th>Owner</th>
    <th>Contact</th>
    <th>Actions</th>
</tr>

<c:forEach var="property" items="${properties}">

<tr>

<td>${property.id}</td>
<td>${property.propertyName}</td>
<td>${property.address}</td>
<td>${property.ownerName}</td>
<td>${property.contactNumber}</td>

<td>

<a href="${pageContext.request.contextPath}/property/edit?id=${property.id}">
    Edit
</a>

<a href="${pageContext.request.contextPath}/property/delete?id=${property.id}"
   onclick="return confirm('Delete this property?');">
    Delete
</a>

</td>

</tr>

</c:forEach>

</table>

</c:when>

<c:otherwise>
    <p>No properties found.</p>
</c:otherwise>

</c:choose>

</div>

</div>

</body>
</html>