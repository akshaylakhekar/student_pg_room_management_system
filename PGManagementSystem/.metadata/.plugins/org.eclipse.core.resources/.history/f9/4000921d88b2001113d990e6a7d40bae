<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">

    <title>Student Complaints</title>

</head>

<body>

    <h2>Student Complaints</h2>

    <c:choose>

        <c:when test="${not empty student}">

            <h3>Student Information</h3>

            <table border="1"
                   cellpadding="10"
                   cellspacing="0">

                <tr>
                    <th>Student ID</th>
                    <td>${student.id}</td>
                </tr>

                <tr>
                    <th>Name</th>
                    <td>${student.name}</td>
                </tr>

                <tr>
                    <th>Email</th>
                    <td>${student.email}</td>
                </tr>

                <tr>
                    <th>Mobile</th>
                    <td>${student.mobile}</td>
                </tr>

            </table>

            <br>

            <a href="${pageContext.request.contextPath}/complaint/add?studentId=${student.id}">
                Add New Complaint
            </a>

            <br><br>

            <p>
                Total Complaints:
                <strong>${complaints.size()}</strong>
            </p>

            <c:choose>

                <c:when test="${not empty complaints}">

                    <table border="1"
                           cellpadding="10"
                           cellspacing="0">

                        <thead>

                            <tr>

                                <th>ID</th>
                                <th>Category</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th>Created At</th>
                                <th>Actions</th>

                            </tr>

                        </thead>

                        <tbody>

                            <c:forEach var="complaint"
                                       items="${complaints}">

                                <tr>

                                    <td>
                                        ${complaint.id}
                                    </td>

                                    <td>
                                        ${complaint.category}
                                    </td>

                                    <td>
                                        ${complaint.description}
                                    </td>

                                    <td>
                                        ${complaint.status}
                                    </td>

                                    <td>
                                        ${complaint.createdAt}
                                    </td>

                                    <td>

                                        <a href="${pageContext.request.contextPath}/complaint/edit?id=${complaint.id}">
                                            Edit
                                        </a>

                                        &nbsp; | &nbsp;

                                        <a href="${pageContext.request.contextPath}/complaint/delete?id=${complaint.id}"
                                           onclick="return confirm('Are you sure you want to delete this complaint?');">
                                            Delete
                                        </a>

                                    </td>

                                </tr>

                            </c:forEach>

                        </tbody>

                    </table>

                </c:when>

                <c:otherwise>

                    <p>
                        No complaints found for this student.
                    </p>

                </c:otherwise>

            </c:choose>

            <br>

            <a href="${pageContext.request.contextPath}/student/profile?id=${student.id}">
                Back to Student Profile
            </a>

            <br><br>

            <a href="${pageContext.request.contextPath}/complaint/list">
                View All Complaints
            </a>

            <br><br>

            <a href="${pageContext.request.contextPath}/dashboard">
                Back to Dashboard
            </a>

        </c:when>

        <c:otherwise>

            <p>
                Student not found.
            </p>

            <br>

            <a href="${pageContext.request.contextPath}/complaint/list">
                Back to Complaint List
            </a>

        </c:otherwise>

    </c:choose>

</body>

</html>