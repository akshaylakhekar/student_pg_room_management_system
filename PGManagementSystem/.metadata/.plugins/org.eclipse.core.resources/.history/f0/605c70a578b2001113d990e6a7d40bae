<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>Room Allocation List</title>
</head>

<body>

    <h2>Room Allocation List</h2>

    <a href="${pageContext.request.contextPath}/allocation/add">
        Add New Allocation
    </a>

    <br><br>

    <form action="${pageContext.request.contextPath}/allocation/list"
          method="get">

        <label>Search:</label>

        <input type="text"
               name="keyword"
               value="${keyword}"
               placeholder="Student name, Student ID, Room number, Room ID or Status">

        <button type="submit">
            Search
        </button>

        <a href="${pageContext.request.contextPath}/allocation/list">
            Clear
        </a>

    </form>

    <br>

    <p>
        Total Allocations:
        <strong>${allocations.size()}</strong>
    </p>

    <c:choose>

        <c:when test="${not empty allocations}">

            <table border="1"
                   cellpadding="10"
                   cellspacing="0">

                <thead>

                    <tr>
                        <th>ID</th>
                        <th>Student ID</th>
                        <th>Student Name</th>
                        <th>Room ID</th>
                        <th>Room Number</th>
                        <th>Monthly Rent</th>
                        <th>Allocation Date</th>
                        <th>Checkout Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>

                </thead>

                <tbody>

                    <c:forEach var="allocation"
                               items="${allocations}">

                        <tr>

                            <td>
                                ${allocation.id}
                            </td>

                            <td>
                                ${allocation.studentId}
                            </td>

                            <td>

                                <c:choose>

                                    <c:when test="${not empty allocation.studentName}">
                                        ${allocation.studentName}
                                    </c:when>

                                    <c:otherwise>
                                        N/A
                                    </c:otherwise>

                                </c:choose>

                            </td>

                            <td>
                                ${allocation.roomId}
                            </td>

                            <td>

                                <c:choose>

                                    <c:when test="${not empty allocation.roomNumber}">
                                        ${allocation.roomNumber}
                                    </c:when>

                                    <c:otherwise>
                                        N/A
                                    </c:otherwise>

                                </c:choose>

                            </td>

                            <td>

                                <c:choose>

                                    <c:when test="${not empty allocation.rentAmount}">
                                        ₹ ${allocation.rentAmount}
                                    </c:when>

                                    <c:otherwise>
                                        N/A
                                    </c:otherwise>

                                </c:choose>

                            </td>

                            <td>

                                <c:choose>

                                    <c:when test="${not empty allocation.allocationDate}">
                                        ${allocation.allocationDate}
                                    </c:when>

                                    <c:otherwise>
                                        -
                                    </c:otherwise>

                                </c:choose>

                            </td>

                            <td>

                                <c:choose>

                                    <c:when test="${not empty allocation.checkoutDate}">
                                        ${allocation.checkoutDate}
                                    </c:when>

                                    <c:otherwise>
                                        -
                                    </c:otherwise>

                                </c:choose>

                            </td>

                            <td>
                                ${allocation.status}
                            </td>

                            <td>

                                <a href="${pageContext.request.contextPath}/payment/history?allocationId=${allocation.id}">
                                    Payment History
                                </a>

                                &nbsp; | &nbsp;

                                <a href="${pageContext.request.contextPath}/allocation/edit?id=${allocation.id}">
                                    Edit
                                </a>

                                <c:if test="${allocation.status == 'Active'}">

                                    &nbsp; | &nbsp;

                                    <a href="${pageContext.request.contextPath}/allocation/checkout?id=${allocation.id}"
                                       onclick="return confirm('Are you sure you want to checkout this student?');">
                                        Checkout
                                    </a>

                                </c:if>

                                &nbsp; | &nbsp;

                                <a href="${pageContext.request.contextPath}/allocation/delete?id=${allocation.id}"
                                   onclick="return confirm('Are you sure you want to delete this allocation?');">
                                    Delete
                                </a>

                            </td>

                        </tr>

                    </c:forEach>

                </tbody>

            </table>

        </c:when>

        <c:otherwise>

            <p>
                No room allocations found.
            </p>

        </c:otherwise>

    </c:choose>

    <br>

    <a href="${pageContext.request.contextPath}/dashboard">
        Back to Dashboard
    </a>

</body>

</html>