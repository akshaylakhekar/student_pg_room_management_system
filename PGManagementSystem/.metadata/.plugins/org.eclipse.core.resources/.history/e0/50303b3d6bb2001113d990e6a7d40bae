<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Room List</title>
</head>
<body>

    <h2>Room List</h2>

    <br>

    <a href="${pageContext.request.contextPath}/room/add">
        Add New Room
    </a>

    <br><br>

    <p>Total Rooms: ${rooms.size()}</p>

    <table border="1" cellpadding="10" cellspacing="0">

        <thead>
            <tr>
                <th>ID</th>
                <th>Property ID</th>
                <th>Room Number</th>
                <th>Capacity</th>
                <th>Sharing Type</th>
                <th>Rent Amount</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            <c:forEach var="room" items="${rooms}">

                <tr>

                    <td>${room.id}</td>

                    <td>${room.propertyId}</td>

                    <td>${room.roomNumber}</td>

                    <td>${room.capacity}</td>

                    <td>${room.sharingType}</td>

                    <td>${room.rentAmount}</td>

                    <td>${room.status}</td>

                    <td>

                        <a href="${pageContext.request.contextPath}/room/edit?id=${room.id}">
                            Edit
                        </a>

                        &nbsp; | &nbsp;

                        <a href="${pageContext.request.contextPath}/room/delete?id=${room.id}"
                           onclick="return confirm('Are you sure you want to delete this room?');">
                            Delete
                        </a>

                    </td>

                </tr>

            </c:forEach>

        </tbody>

    </table>

</body>
</html>