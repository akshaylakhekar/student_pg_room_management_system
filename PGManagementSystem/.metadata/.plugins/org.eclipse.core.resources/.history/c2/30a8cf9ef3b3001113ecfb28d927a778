<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">

    <title>Edit Complaint</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f7fb;
            color: #1e293b;
        }

        .navbar {
            background: #1e293b;
            color: white;
            padding: 18px 30px;
        }

        .navbar h2 {
            margin: 0;
            font-size: 22px;
        }

        .container {
            width: 90%;
            max-width: 750px;
            margin: 40px auto;
        }

        .card {
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .card h2 {
            margin-top: 0;
            margin-bottom: 25px;
            color: #1e293b;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 7px;
            font-weight: bold;
            color: #334155;
        }

        input,
        select,
        textarea {
            width: 100%;
            padding: 11px 12px;
            border: 1px solid #cbd5e1;
            border-radius: 7px;
            font-size: 14px;
            outline: none;
        }

        input:focus,
        select:focus,
        textarea:focus {
            border-color: #2563eb;
        }

        textarea {
            min-height: 120px;
            resize: vertical;
        }

        .info-box {
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            padding: 12px 15px;
            border-radius: 7px;
            margin-bottom: 22px;
            color: #1e40af;
        }

        .buttons {
            display: flex;
            gap: 12px;
            margin-top: 25px;
        }

        .btn {
            display: inline-block;
            padding: 11px 20px;
            border: none;
            border-radius: 7px;
            text-decoration: none;
            font-size: 14px;
            cursor: pointer;
        }

        .btn-primary {
            background: #2563eb;
            color: white;
        }

        .btn-primary:hover {
            background: #1d4ed8;
        }

        .btn-secondary {
            background: #64748b;
            color: white;
        }

        .btn-secondary:hover {
            background: #475569;
        }

        .required {
            color: #dc2626;
        }

        @media (max-width: 600px) {

            .container {
                width: 94%;
                margin: 25px auto;
            }

            .card {
                padding: 20px;
            }

            .buttons {
                flex-direction: column;
            }

            .btn {
                text-align: center;
            }

        }

    </style>

</head>

<body>

    <div class="navbar">
        <h2>PG Management System</h2>
    </div>

    <div class="container">

        <div class="card">

            <h2>Edit Complaint</h2>

            <div class="info-box">
                Complaint ID:
                <strong>${complaint.id}</strong>
            </div>

            <form action="${pageContext.request.contextPath}/complaint/update"
                  method="post">

                <input type="hidden"
                       name="id"
                       value="${complaint.id}">


                <div class="form-group">

                    <label>
                        Student <span class="required">*</span>
                    </label>

                    <select name="studentId" required>

                        <option value="">
                            -- Select Student --
                        </option>

                        <c:forEach var="student"
                                   items="${students}">

                            <option value="${student.id}"
                                <c:if test="${complaint.studentId == student.id}">
                                    selected
                                </c:if>
                            >
                                ${student.name} - ${student.email}
                            </option>

                        </c:forEach>

                    </select>

                </div>


                <div class="form-group">

                    <label>
                        Category <span class="required">*</span>
                    </label>

                    <select name="category" required>

                        <option value="">
                            -- Select Category --
                        </option>

                        <option value="Room"
                            <c:if test="${complaint.category == 'Room'}">
                                selected
                            </c:if>
                        >
                            Room
                        </option>

                        <option value="Food"
                            <c:if test="${complaint.category == 'Food'}">
                                selected
                            </c:if>
                        >
                            Food
                        </option>

                        <option value="Maintenance"
                            <c:if test="${complaint.category == 'Maintenance'}">
                                selected
                            </c:if>
                        >
                            Maintenance
                        </option>

                        <option value="Electricity"
                            <c:if test="${complaint.category == 'Electricity'}">
                                selected
                            </c:if>
                        >
                            Electricity
                        </option>

                        <option value="Water"
                            <c:if test="${complaint.category == 'Water'}">
                                selected
                            </c:if>
                        >
                            Water
                        </option>

                        <option value="Other"
                            <c:if test="${complaint.category == 'Other'}">
                                selected
                            </c:if>
                        >
                            Other
                        </option>

                    </select>

                </div>


                <div class="form-group">

                    <label>
                        Description <span class="required">*</span>
                    </label>

                    <textarea name="description"
                              placeholder="Enter complaint details..."
                              required>${complaint.description}</textarea>

                </div>


                <div class="form-group">

                    <label>
                        Status <span class="required">*</span>
                    </label>

                    <select name="status" required>

                        <option value="">
                            -- Select Status --
                        </option>

                        <option value="Pending"
                            <c:if test="${complaint.status == 'Pending'}">
                                selected
                            </c:if>
                        >
                            Pending
                        </option>

                        <option value="Open"
                            <c:if test="${complaint.status == 'Open'}">
                                selected
                            </c:if>
                        >
                            Open
                        </option>

                        <option value="Resolved"
                            <c:if test="${complaint.status == 'Resolved'}">
                                selected
                            </c:if>
                        >
                            Resolved
                        </option>

                        <option value="Closed"
                            <c:if test="${complaint.status == 'Closed'}">
                                selected
                            </c:if>
                        >
                            Closed
                        </option>

                    </select>

                </div>


                <div class="buttons">

                    <button type="submit"
                            class="btn btn-primary">
                        Update Complaint
                    </button>

                    <a href="${pageContext.request.contextPath}/complaint/list"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</body>

</html>