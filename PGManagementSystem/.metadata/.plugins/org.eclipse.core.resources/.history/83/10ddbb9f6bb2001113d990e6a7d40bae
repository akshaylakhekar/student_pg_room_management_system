package com.pgmanagement.dao;

import java.util.List;

import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Repository;

import com.pgmanagement.model.RentPayment;

@Repository
public class RentPaymentDAO {

    private final JdbcTemplate jdbcTemplate;

    public RentPaymentDAO(JdbcTemplate jdbcTemplate) {
        this.jdbcTemplate = jdbcTemplate;
    }

    public boolean addPayment(RentPayment payment) {

        String sql = "INSERT INTO rent_payments "
                   + "(allocation_id, amount, payment_date, "
                   + "month_year, payment_status) "
                   + "VALUES (?, ?, ?, ?, ?)";

        int rows = jdbcTemplate.update(
                sql,
                payment.getAllocationId(),
                payment.getAmount(),
                payment.getPaymentDate(),
                payment.getMonthYear(),
                payment.getPaymentStatus()
        );

        return rows > 0;
    }

    public List<RentPayment> getAllPayments() {

        String sql =
                "SELECT * FROM rent_payments ORDER BY id DESC";

        return jdbcTemplate.query(
                sql,
                (rs, rowNum) -> {

                    RentPayment payment =
                            new RentPayment();

                    payment.setId(
                            rs.getInt("id")
                    );

                    payment.setAllocationId(
                            rs.getInt("allocation_id")
                    );

                    payment.setAmount(
                            rs.getBigDecimal("amount")
                    );

                    if (rs.getDate("payment_date") != null) {

                        payment.setPaymentDate(
                                rs.getDate("payment_date")
                                        .toLocalDate()
                        );
                    }

                    payment.setMonthYear(
                            rs.getString("month_year")
                    );

                    payment.setPaymentStatus(
                            rs.getString("payment_status")
                    );

                    return payment;
                }
        );
    }

    public RentPayment getPaymentById(int id) {

        String sql =
                "SELECT * FROM rent_payments WHERE id = ?";

        return jdbcTemplate.queryForObject(
                sql,
                (rs, rowNum) -> {

                    RentPayment payment =
                            new RentPayment();

                    payment.setId(
                            rs.getInt("id")
                    );

                    payment.setAllocationId(
                            rs.getInt("allocation_id")
                    );

                    payment.setAmount(
                            rs.getBigDecimal("amount")
                    );

                    if (rs.getDate("payment_date") != null) {

                        payment.setPaymentDate(
                                rs.getDate("payment_date")
                                        .toLocalDate()
                        );
                    }

                    payment.setMonthYear(
                            rs.getString("month_year")
                    );

                    payment.setPaymentStatus(
                            rs.getString("payment_status")
                    );

                    return payment;
                },
                id
        );
    }

    public boolean updatePayment(RentPayment payment) {

        String sql = "UPDATE rent_payments SET "
                   + "allocation_id = ?, "
                   + "amount = ?, "
                   + "payment_date = ?, "
                   + "month_year = ?, "
                   + "payment_status = ? "
                   + "WHERE id = ?";

        int rows = jdbcTemplate.update(
                sql,
                payment.getAllocationId(),
                payment.getAmount(),
                payment.getPaymentDate(),
                payment.getMonthYear(),
                payment.getPaymentStatus(),
                payment.getId()
        );

        return rows > 0;
    }

    public boolean deletePayment(int id) {

        String sql =
                "DELETE FROM rent_payments WHERE id = ?";

        int rows = jdbcTemplate.update(sql, id);

        return rows > 0;
    }
}