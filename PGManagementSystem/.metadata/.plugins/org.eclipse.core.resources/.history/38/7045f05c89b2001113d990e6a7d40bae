<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Add Room</title>

    <style>
        body {
            margin: 0;
            font-family: Arial;
            background: #f4f7fb;
        }

        .navbar {
            background: #1e293b;
            color: white;
            padding: 18px 40px;
        }

        .container {
            max-width: 750px;
            width: 92%;
            margin: 35px auto;
        }

        .card {
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,.08);
        }

        label {
            display: block;
            font-weight: bold;
            margin: 15px 0 7px;
        }

        input, select {
            width: 100%;
            padding: 11px;
            box-sizing: border-box;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
        }

        button {
            margin-top: 20px;
            padding: 11px 20px;
            background: #2563eb;
            color: white;
            border: none;
            border-radius: 6px;
        }

        .error {
            background: #fee2e2;
            color: #991b1b;
            padding: 12px;
            border-radius: 6px;
        }

        a {
            color: #2563eb;
            text-decoration: none;
        }
    </style>
</head>

<body>

<div class="navbar">
    <h2>PG Management System</h2>
</div>

<div class="container">

<div class="card">

<h1>Add Room</h1>

<c:if test="${not empty errorMessage}">
    <div class="error">${errorMessage}</div>
</c:if>

<form action="${pageContext.request.contextPath}/room/save"
      method="post">

    <label>Property</label>

    <select name="propertyId" required>

        <option value="">-- Select Property --</option>

        <c:forEach var="property" items="${properties}">

            <option value="${property.id}">
                ${property.propertyName}
            </option>

        </c:forEach>

    </select>

    <label>Room Number</label>
    <input type="text"
           name="roomNumber"
           required>

    <label>Capacity</label>
    <input type="number"
           name="capacity"
           min="1"
           required>

    <label>Sharing Type</label>
    <input type="text"
           name="sharingType"
           placeholder="Single / Double / Triple"
           required>

    <label>Rent Amount</label>
    <input type="number"
           name="rentAmount"
           step="0.01"
           min="0.01"
           required>

    <label>Status</label>

    <select name="status" required>

        <option value="">-- Select Status --</option>
        <option value="Available">Available</option>
        <option value="Occupied">Occupied</option>

    </select>

    <button type="submit">
        Save Room
    </button>

</form>

<br>

<a href="${pageContext.request.contextPath}/room/list">
    ← Back to Room List
</a>

</div>

</div>

</body>
</html>