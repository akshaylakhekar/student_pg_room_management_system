package com.pgmanagement.service;

import java.util.List;

import org.springframework.stereotype.Service;

import com.pgmanagement.dao.StudentDAO;
import com.pgmanagement.model.Student;

@Service
public class StudentService {

    private final StudentDAO studentDAO;

    // StudentDAO Spring automatically inject karega
    public StudentService(StudentDAO studentDAO) {
        this.studentDAO = studentDAO;
    }

    // Student save karne ke liye
    public boolean addStudent(Student student) {
        return studentDAO.addStudent(student);
    }

    // Saare students fetch karne ke liye
    public List<Student> getAllStudents() {
        return studentDAO.getAllStudents();
    }

    // ID ke basis par student fetch karne ke liye
    public Student getStudentById(int id) {
        return studentDAO.getStudentById(id);
    }

    // Student update karne ke liye
    public boolean updateStudent(Student student) {
        return studentDAO.updateStudent(student);
    }

    // Student delete karne ke liye
    public boolean deleteStudent(int id) {
        return studentDAO.deleteStudent(id);
    }
}