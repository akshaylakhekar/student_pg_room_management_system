<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">

    <title>Student List</title>

</head>

<body>

    <h2>Student List</h2>

    <c:if test="${not empty errorMessage}">

        <p>
            <strong>${errorMessage}</strong>
        </p>

    </c:if>

    <a href="${pageContext.request.contextPath}/student/add">
        Add New Student
    </a>

    <br><br>

    <form action="${pageContext.request.contextPath}/student/list"
          method="get">

        <label>Search Student:</label>

        <input type="text"
               name="keyword"
               value="${keyword}"
               placeholder="Name, Email or Mobile">

        <button type="submit">
            Search
        </button>

        <a href="${pageContext.request.contextPath}/student/list">
            Clear
        </a>

    </form>

    <br>

    <p>
        Total Students:
        <strong>${students.size()}</strong>
    </p>

    <c:choose>

        <c:when test="${not empty students}">

            <table border="1"
                   cellpadding="10"
                   cellspacing="0">

                <thead>

                    <tr>

                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Mobile</th>
                        <th>Guardian Mobile</th>
                        <th>Address</th>
                        <th>ID Proof</th>
                        <th>Actions</th>

                    </tr>

                </thead>

                <tbody>

                    <c:forEach var="student"
                               items="${students}">

                        <tr>

                            <td>
                                ${student.id}
                            </td>

                            <td>
                                ${student.name}
                            </td>

                            <td>
                                ${student.email}
                            </td>

                            <td>
                                ${student.mobile}
                            </td>

                            <td>
                                ${student.guardianMobile}
                            </td>

                            <td>
                                ${student.address}
                            </td>

                            <td>
                                ${student.idProof}
                            </td>

                            <td>

                                <a href="${pageContext.request.contextPath}/student/profile?id=${student.id}">
                                    Profile
                                </a>

                                &nbsp; | &nbsp;

                                <a href="${pageContext.request.contextPath}/student/edit?id=${student.id}">
                                    Edit
                                </a>

                                &nbsp; | &nbsp;

                                <a href="${pageContext.request.contextPath}/student/delete?id=${student.id}"
                                   onclick="return confirm('Are you sure you want to delete this student?');">
                                    Delete
                                </a>

                            </td>

                        </tr>

                    </c:forEach>

                </tbody>

            </table>

        </c:when>

        <c:otherwise>

            <p>
                No students found.
            </p>

        </c:otherwise>

    </c:choose>

    <br>

    <a href="${pageContext.request.contextPath}/dashboard">
        Back to Dashboard
    </a>

</body>

</html>