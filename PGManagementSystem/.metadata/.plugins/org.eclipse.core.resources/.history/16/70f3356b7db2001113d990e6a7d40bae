<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">

    <title>Edit Rent Payment</title>

</head>

<body>

    <h2>Edit Rent Payment</h2>

    <c:if test="${not empty errorMessage}">

        <p>
            <strong>${errorMessage}</strong>
        </p>

    </c:if>

    <form action="${pageContext.request.contextPath}/payment/update"
          method="post">

        <input type="hidden"
               name="id"
               value="${payment.id}">

        <label>Allocation:</label>

        <select name="allocationId" required>

            <option value="">
                -- Select Allocation --
            </option>

            <c:forEach var="allocation"
                       items="${allocations}">

                <option value="${allocation.id}"
                    <c:if test="${payment.allocationId == allocation.id}">
                        selected
                    </c:if>
                >
                    Allocation ID: ${allocation.id}
                    | Student ID: ${allocation.studentId}
                    | Room ID: ${allocation.roomId}
                    | Status: ${allocation.status}
                </option>

            </c:forEach>

        </select>

        <br><br>

        <label>Amount:</label>

        <input type="number"
               name="amount"
               step="0.01"
               min="0"
               value="${payment.amount}"
               required>

        <br><br>

        <label>Payment Date:</label>

        <input type="date"
               name="paymentDate"
               value="${payment.paymentDate}"
               required>

        <br><br>

        <label>Month/Year:</label>

        <input type="text"
               name="monthYear"
               value="${payment.monthYear}"
               placeholder="Example: September 2026"
               required>

        <br><br>

        <label>Payment Status:</label>

        <select name="paymentStatus" required>

            <option value="">
                -- Select Status --
            </option>

            <option value="Paid"
                <c:if test="${payment.paymentStatus == 'Paid'}">
                    selected
                </c:if>
            >
                Paid
            </option>

            <option value="Pending"
                <c:if test="${payment.paymentStatus == 'Pending'}">
                    selected
                </c:if>
            >
                Pending
            </option>

        </select>

        <br><br>

        <button type="submit">
            Update Payment
        </button>

    </form>

    <br>

    <a href="${pageContext.request.contextPath}/payment/list">
        Back to Payment List
    </a>

</body>

</html>