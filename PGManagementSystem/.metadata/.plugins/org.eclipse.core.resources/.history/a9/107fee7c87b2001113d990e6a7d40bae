<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">

    <title>Payment Receipt</title>

</head>

<body>

    <h2>PG Management System</h2>

    <h3>Rent Payment Receipt</h3>

    <hr>

    <c:choose>

        <c:when test="${not empty payment}">

            <table border="1"
                   cellpadding="10"
                   cellspacing="0">

                <tr>
                    <th>Payment ID</th>
                    <td>${payment.id}</td>
                </tr>

                <tr>
                    <th>Allocation ID</th>
                    <td>${payment.allocationId}</td>
                </tr>

                <tr>
                    <th>Student Name</th>
                    <td>

                        <c:choose>

                            <c:when test="${not empty payment.studentName}">
                                ${payment.studentName}
                            </c:when>

                            <c:otherwise>
                                N/A
                            </c:otherwise>

                        </c:choose>

                    </td>
                </tr>

                <tr>
                    <th>Room Number</th>
                    <td>

                        <c:choose>

                            <c:when test="${not empty payment.roomNumber}">
                                ${payment.roomNumber}
                            </c:when>

                            <c:otherwise>
                                N/A
                            </c:otherwise>

                        </c:choose>

                    </td>
                </tr>

                <tr>
                    <th>Amount Paid</th>
                    <td>
                        ₹ ${payment.amount}
                    </td>
                </tr>

                <tr>
                    <th>Payment Date</th>
                    <td>
                        ${payment.paymentDate}
                    </td>
                </tr>

                <tr>
                    <th>Month / Year</th>
                    <td>
                        ${payment.monthYear}
                    </td>
                </tr>

                <tr>
                    <th>Payment Status</th>
                    <td>
                        ${payment.paymentStatus}
                    </td>
                </tr>

            </table>

            <br>

            <h3>Rent Summary</h3>

            <table border="1"
                   cellpadding="10"
                   cellspacing="0">

                <tr>
                    <th>Monthly Rent</th>
                    <td>
                        ₹ ${monthlyRent}
                    </td>
                </tr>

                <tr>
                    <th>Total Amount Paid</th>
                    <td>
                        ₹ ${totalAmount}
                    </td>
                </tr>

                <tr>
                    <th>Balance Due</th>
                    <td>
                        ₹ ${balanceDue}
                    </td>
                </tr>

            </table>

            <br>

            <button type="button"
                    onclick="window.print()">
                Print Receipt
            </button>

            <br><br>

            <a href="${pageContext.request.contextPath}/payment/list">
                Back to Payment List
            </a>

            <br><br>

            <a href="${pageContext.request.contextPath}/payment/history?allocationId=${payment.allocationId}">
                Back to Payment History
            </a>

            <br><br>

            <a href="${pageContext.request.contextPath}/dashboard">
                Back to Dashboard
            </a>

        </c:when>

        <c:otherwise>

            <p>
                Payment receipt not found.
            </p>

            <br>

            <a href="${pageContext.request.contextPath}/payment/list">
                Back to Payment List
            </a>

        </c:otherwise>

    </c:choose>

</body>

</html>