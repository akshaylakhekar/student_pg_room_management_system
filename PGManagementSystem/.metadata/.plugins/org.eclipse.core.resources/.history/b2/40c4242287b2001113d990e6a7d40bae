<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">

    <title>Add Room</title>

</head>

<body>

    <h2>Add New Room</h2>

    <c:if test="${not empty errorMessage}">

        <p>
            <strong>${errorMessage}</strong>
        </p>

    </c:if>

    <form action="${pageContext.request.contextPath}/room/save"
          method="post">

        <label>Property:</label>

        <select name="propertyId"
                required>

            <option value="">
                -- Select Property --
            </option>

            <c:forEach var="property"
                       items="${properties}">

                <option value="${property.id}"
                    <c:if test="${room.propertyId == property.id}">
                        selected
                    </c:if>
                >
                    ${property.propertyName}
                    -
                    ${property.address}
                </option>

            </c:forEach>

        </select>

        <br><br>

        <label>Room Number:</label>

        <input type="text"
               name="roomNumber"
               value="${room.roomNumber}"
               required>

        <br><br>

        <label>Capacity:</label>

        <input type="number"
               name="capacity"
               min="1"
               value="${room.capacity}"
               required>

        <br><br>

        <label>Sharing Type:</label>

        <input type="text"
               name="sharingType"
               value="${room.sharingType}"
               placeholder="Single / Double / Triple"
               required>

        <br><br>

        <label>Rent Amount:</label>

        <input type="number"
               name="rentAmount"
               step="0.01"
               min="0.01"
               value="${room.rentAmount}"
               required>

        <br><br>

        <label>Status:</label>

        <select name="status"
                required>

            <option value="">
                -- Select Status --
            </option>

            <option value="Available"
                <c:if test="${room.status == 'Available'}">
                    selected
                </c:if>
            >
                Available
            </option>

            <option value="Occupied"
                <c:if test="${room.status == 'Occupied'}">
                    selected
                </c:if>
            >
                Occupied
            </option>

        </select>

        <br><br>

        <button type="submit">
            Save Room
        </button>

    </form>

    <br>

    <a href="${pageContext.request.contextPath}/room/list">
        Back to Room List
    </a>

    <br><br>

    <a href="${pageContext.request.contextPath}/dashboard">
        Back to Dashboard
    </a>

</body>

</html>